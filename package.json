{
  "name": "hr-enterprise-platform",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "HR Enterprise Platform - one employee data, one organization, one permission system, one platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "(npm run dev -w apps/api & npm run dev -w apps/web & wait)",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "test": "npm run test -w apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "db:deploy": "npm run db:deploy -w apps/api",
    "db:seed:demo": "npm run db:seed:demo -w apps/api",
    "bootstrap:admin": "npm run bootstrap:admin -w apps/api",
    "db:backup": "npm run db:backup -w apps/api",
    "db:restore:verify": "npm run db:restore:verify -w apps/api",
    "ops:check": "npm run ops:check -w apps/api",
    "ops:revoke-sessions": "npm run ops:revoke-sessions -w apps/api",
    "ops:cleanup-reset-tokens": "npm run ops:cleanup-reset-tokens -w apps/api"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
