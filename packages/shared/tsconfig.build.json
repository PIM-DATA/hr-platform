{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The compiled API is CommonJS, so the runtime build of @hr/shared is CommonJS too. The source stays
    // ESM/bundler-resolved for Vite and for typechecking (package.json "types" points at src).
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
