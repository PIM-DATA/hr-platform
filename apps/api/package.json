{
  "name": "@hr/api",
  "version": "0.1.0",
  "private": true,
  "description": "HR Enterprise Platform REST API",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:test:reset": "NODE_ENV=test tsx scripts/reset-test-db.ts",
    "test": "npm run -s db:test:reset && NODE_ENV=test vitest run",
    "build": "tsc -p tsconfig.build.json",
    "db:seed:demo": "tsx prisma/seed.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore:verify": "tsx scripts/restore-verify.ts",
    "ops:check": "tsx scripts/ops-check.ts",
    "ops:revoke-sessions": "tsx scripts/revoke-sessions.ts",
    "ops:cleanup-reset-tokens": "tsx scripts/cleanup-reset-tokens.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hr/shared": "*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
