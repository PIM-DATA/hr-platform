// HR Enterprise Platform — Phase 1 schema
//
// Conventions
//  - Table / column names are snake_case via @@map / @map (portable to PostgreSQL).
//  - ids are cuid strings (no guessable sequential ids).
//  - Enum-like values are TEXT columns; the allowed values live in @hr/shared (SQLite has no enums).
//  - No hard deletes for master data: is_active / employment_status flags instead.
//
// Switching to PostgreSQL: change `provider` below, set DATABASE_URL, delete prisma/migrations
// (SQLite SQL is not portable) and run `prisma migrate dev --name init` again.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================================
// SECURITY / IDENTITY
// =====================================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  employeeId   String?   @unique @map("employee_id")
  employee     Employee? @relation(fields: [employeeId], references: [id])
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  userRoles UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]

  // workflow (Phase 2)
  workflowDefinitionSteps WorkflowDefinitionStep[]
  workflowRequests        WorkflowInstance[]     @relation("WorkflowRequesterUser")
  workflowApproverSteps   WorkflowInstanceStep[] @relation("WorkflowStepApproverUser")
  workflowActedSteps      WorkflowInstanceStep[] @relation("WorkflowStepActedBy")
  workflowActions         WorkflowAction[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique // EMPLOYEE | MANAGER | HR | HR_ADMIN | EXECUTIVE | SYSTEM_ADMIN
  name        String
  description String?
  dataScope   String   @default("SELF") @map("data_scope") // SELF | TEAM | ALL
  isSystem    Boolean  @default(false) @map("is_system") // system roles cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]
  workflowDefinitionSteps WorkflowDefinitionStep[] // reserved for ROLE approvers (not enabled)

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique // e.g. employees.update
  module      String
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// DB-backed sessions. Only the SHA-256 hash of the cookie token is stored.
/// csrf_token is a separate random value (synchronizer token) — never the session token.
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  csrfToken String   @map("csrf_token")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// =====================================================================
// ORGANIZATION
// =====================================================================

model Organization {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  /// IANA timezone (e.g. Asia/Bangkok) — source of truth for business "today" in this organization
  timezone  String   @default("Asia/Bangkok")
  /// Work calendar used for leave/attendance calculations unless an employee-level assignment exists (Phase 2B)
  defaultCalendarId String?       @map("default_calendar_id")
  defaultCalendar   WorkCalendar? @relation("OrganizationDefaultCalendar", fields: [defaultCalendarId], references: [id])
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  departments   Department[]
  employees     Employee[]
  workCalendars WorkCalendar[] @relation("OrganizationCalendars")
  leavePolicies LeavePolicy[]

  @@map("organizations")
}

model Department {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  parentId       String?      @map("parent_id") // sub-department support
  parent         Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentTree")
  code           String
  name           String
  headEmployeeId String?      @map("head_employee_id")
  headEmployee   Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  positions         Position[]
  employees         Employee[]
  employeePositions EmployeePosition[]

  @@unique([organizationId, code])
  @@index([parentId])
  @@map("departments")
}

/// Job = job title / level template, independent of department (e.g. "Manager", level 3).
model Job {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  level       Int      @default(1)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  positions Position[]

  @@map("jobs")
}

/// Position = a concrete seat inside a department (e.g. "Sales Manager" in Sales).
model Position {
  id           String     @id @default(cuid())
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  jobId        String?    @map("job_id")
  job          Job?       @relation(fields: [jobId], references: [id])
  code         String     @unique
  title        String
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  employees         Employee[]
  employeePositions EmployeePosition[]

  @@index([departmentId])
  @@map("positions")
}

// =====================================================================
// EMPLOYEE MASTER  (single source of truth — every module references employees.id)
// =====================================================================

model Employee {
  id              String    @id @default(cuid())
  employeeCode    String    @unique @map("employee_code")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  nickname        String?
  email           String    @unique
  phone           String?
  hireDate        DateTime  @map("hire_date")
  terminationDate DateTime? @map("termination_date")

  // current assignment (denormalized for fast queries; history in employee_positions / employee_managers)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  departmentId   String       @map("department_id")
  department     Department   @relation(fields: [departmentId], references: [id])
  positionId     String       @map("position_id")
  position       Position     @relation(fields: [positionId], references: [id])
  managerId      String?      @map("manager_id")
  manager        Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports  Employee[]   @relation("EmployeeManager")

  employmentType   String @default("FULL_TIME") @map("employment_type") // FULL_TIME | PART_TIME | CONTRACT | INTERN
  employmentStatus String @default("ACTIVE") @map("employment_status") // ACTIVE | INACTIVE | TERMINATED

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") // users.id
  updatedBy String?  @map("updated_by") // users.id

  user             User?
  headOfDepartments Department[]       @relation("DepartmentHead")
  positionHistory  EmployeePosition[]
  managerHistory   EmployeeManager[]   @relation("ManagerHistoryEmployee")
  managedHistory   EmployeeManager[]   @relation("ManagerHistoryManager")
  workflowRequests      WorkflowInstance[]     @relation("WorkflowRequesterEmployee")
  workflowApproverSteps WorkflowInstanceStep[] @relation("WorkflowStepApproverEmployee")

  @@index([departmentId])
  @@index([managerId])
  @@index([employmentStatus])
  @@map("employees")
}

/// Position assignment history. end_date NULL = current.
model EmployeePosition {
  id           String     @id @default(cuid())
  employeeId   String     @map("employee_id")
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  positionId   String     @map("position_id")
  position     Position   @relation(fields: [positionId], references: [id])
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  startDate    DateTime   @map("start_date")
  endDate      DateTime?  @map("end_date")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("employee_positions")
}

/// Manager assignment history. end_date NULL = current.
model EmployeeManager {
  id         String    @id @default(cuid())
  employeeId String    @map("employee_id")
  employee   Employee  @relation("ManagerHistoryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  managerId  String    @map("manager_id")
  manager    Employee  @relation("ManagerHistoryManager", fields: [managerId], references: [id])
  startDate  DateTime  @map("start_date")
  endDate    DateTime? @map("end_date")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("employee_managers")
}

// =====================================================================
// SHARED SERVICES
// =====================================================================

/// Field-level audit trail. old_value / new_value are JSON text (only changed fields, sensitive keys redacted).
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id") // actor; null for system actions
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. UPDATE_EMPLOYEE
  module     String   // e.g. employees
  recordType String   @map("record_type") // e.g. Employee
  recordId   String?  @map("record_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // list is always ordered by created_at desc and filtered by one of: actor, module, action, record
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@index([action, createdAt])
  @@index([recordType, recordId])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("system_settings")
}

// =====================================================================
// WORKFLOW ENGINE (shared service, Phase 2)
// =====================================================================

/// MASTER, versioned. A (code, version) row is immutable once created; "editing" = new version. One active version per code (enforced in service).
model WorkflowDefinition {
  id          String    @id @default(cuid())
  code        String
  version     Int
  name        String
  description String?
  module      String // business module key, e.g. leave
  entityType  String // business entity, e.g. LeaveRequest
  isActive    Boolean   @default(false) @map("is_active")
  activatedAt DateTime? @map("activated_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")

  steps     WorkflowDefinitionStep[]
  instances WorkflowInstance[]

  @@unique([code, version])
  @@index([code, isActive])
  @@map("workflow_definitions")
}

/// MASTER. Sequential steps 1..n of a definition version.
model WorkflowDefinitionStep {
  id             String             @id @default(cuid())
  definitionId   String             @map("definition_id")
  definition     WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  stepOrder      Int                @map("step_order")
  name           String
  approverType   String             @map("approver_type") // DIRECT_MANAGER | DEPARTMENT_HEAD | SPECIFIC_USER | ROLE (reserved)
  approverUserId String?            @map("approver_user_id")
  approverUser   User?              @relation(fields: [approverUserId], references: [id])
  approverRoleId String?            @map("approver_role_id") // reserved, never set in Phase 2
  approverRole   Role?              @relation(fields: [approverRoleId], references: [id])
  onSelf         String             @default("FAIL") @map("on_self") // FAIL | SKIP
  onUnresolved   String             @default("FAIL") @map("on_unresolved") // FAIL | SKIP

  @@unique([definitionId, stepOrder])
  @@map("workflow_definition_steps")
}

/// TRANSACTION. One running/finished workflow for a business entity (module, entityType, entityId).
model WorkflowInstance {
  id                  String             @id @default(cuid())
  definitionId        String             @map("definition_id") // the exact version used
  definition          WorkflowDefinition @relation(fields: [definitionId], references: [id])
  module              String
  entityType          String             @map("entity_type")
  entityId            String             @map("entity_id")
  requesterEmployeeId String             @map("requester_employee_id")
  requesterEmployee   Employee           @relation("WorkflowRequesterEmployee", fields: [requesterEmployeeId], references: [id])
  requesterUserId     String?            @map("requester_user_id")
  requesterUser       User?              @relation("WorkflowRequesterUser", fields: [requesterUserId], references: [id])
  status              String             @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  currentStepOrder    Int?               @map("current_step_order")
  submittedAt         DateTime           @default(now()) @map("submitted_at")
  completedAt         DateTime?          @map("completed_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  steps   WorkflowInstanceStep[]
  actions WorkflowAction[]

  @@index([module, entityType, entityId])
  @@index([requesterEmployeeId])
  @@index([status])
  @@map("workflow_instances")
}

/// SNAPSHOT. Steps copied from the definition at submit time with the approver resolved then; later org changes never touch these rows.
model WorkflowInstanceStep {
  id                 String           @id @default(cuid())
  instanceId         String           @map("instance_id")
  instance           WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepOrder          Int              @map("step_order")
  name               String
  approverType       String           @map("approver_type")
  approverEmployeeId String?          @map("approver_employee_id")
  approverEmployee   Employee?        @relation("WorkflowStepApproverEmployee", fields: [approverEmployeeId], references: [id])
  approverUserId     String?          @map("approver_user_id")
  approverUser       User?            @relation("WorkflowStepApproverUser", fields: [approverUserId], references: [id])
  approverRoleId     String?          @map("approver_role_id") // reserved
  status             String           @default("WAITING") // WAITING | PENDING | APPROVED | REJECTED | SKIPPED | CANCELLED
  skipReason         String?          @map("skip_reason") // SELF | UNRESOLVED
  actedByUserId      String?          @map("acted_by_user_id") // kept separate from approverUserId (future delegation)
  actedBy            User?            @relation("WorkflowStepActedBy", fields: [actedByUserId], references: [id])
  actedAt            DateTime?        @map("acted_at")
  comment            String?

  @@unique([instanceId, stepOrder])
  @@index([approverUserId, status])
  @@map("workflow_instance_steps")
}

/// HISTORY, append-only. SUBMIT / APPROVE / REJECT / CANCEL with actor and comment.
model WorkflowAction {
  id          String           @id @default(cuid())
  instanceId  String           @map("instance_id")
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepOrder   Int?             @map("step_order")
  action      String
  actorUserId String?          @map("actor_user_id")
  actor       User?            @relation(fields: [actorUserId], references: [id])
  comment     String?
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([instanceId, createdAt])
  @@map("workflow_actions")
}

// =====================================================================
// WORK CALENDAR (shared HRM master — reused by Leave and, later, Attendance)
// =====================================================================

/// MASTER. Working weekdays of an organization calendar; working_days is a JSON array of MON..SUN (validated + normalized by the service).
model WorkCalendar {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation("OrganizationCalendars", fields: [organizationId], references: [id])
  code           String
  name           String
  workingDays    String       @map("working_days") // JSON text, e.g. ["MON","TUE","WED","THU","FRI"]
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdBy      String?      @map("created_by")
  updatedBy      String?      @map("updated_by")

  holidays          Holiday[]
  defaultForOrgs    Organization[] @relation("OrganizationDefaultCalendar")

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("work_calendars")
}

/// MASTER. Holiday dates (YYYY-MM-DD) of a calendar; may fall on non-working days.
model Holiday {
  id         String       @id @default(cuid())
  calendarId String       @map("calendar_id")
  calendar   WorkCalendar @relation(fields: [calendarId], references: [id])
  date       String // business date YYYY-MM-DD
  name       String
  isActive   Boolean      @default(true) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  createdBy  String?      @map("created_by")
  updatedBy  String?      @map("updated_by")

  @@unique([calendarId, date])
  @@map("holidays")
}

// =====================================================================
// LEAVE — MASTER DATA (Phase 2, Task 9)
// =====================================================================

/// MASTER (semantic only). Business rules live on leave_policies.
model LeaveType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  policies LeavePolicy[]

  @@map("leave_types")
}

/// MASTER. Rules for a leave type in an (organization, employmentType) context; null selectors = ANY.
/// policyId is a historical identity: entitlements/requests will reference it (guard against silent rule edits comes with those tables).
model LeavePolicy {
  id                       String        @id @default(cuid())
  name                     String
  leaveTypeId              String        @map("leave_type_id")
  leaveType                LeaveType     @relation(fields: [leaveTypeId], references: [id])
  organizationId           String?       @map("organization_id")
  organization             Organization? @relation(fields: [organizationId], references: [id])
  employmentType           String?       @map("employment_type") // FULL_TIME | PART_TIME | CONTRACT | INTERN | null = any
  annualUnits              Float         @map("annual_units") // days, multiples of 0.5
  isPaid                   Boolean       @default(true) @map("is_paid")
  requiresReason           Boolean       @default(false) @map("requires_reason")
  requiresAttachment       Boolean       @default(false) @map("requires_attachment")
  allowHalfDay             Boolean       @default(true) @map("allow_half_day")
  allowNegativeBalance     Boolean       @default(false) @map("allow_negative_balance")
  maxConsecutiveDays       Int?          @map("max_consecutive_days")
  minNoticeDays            Int?          @map("min_notice_days")
  allowBackdate            Boolean       @default(false) @map("allow_backdate")
  carryForwardMaxUnits     Float         @default(0) @map("carry_forward_max_units")
  carryForwardExpiryMonths Int?          @map("carry_forward_expiry_months")
  workflowDefinitionCode   String?       @map("workflow_definition_code") // must be an active workflow for leave/LEAVE_REQUEST when the policy is active
  effectiveFrom            String        @map("effective_from") // YYYY-MM-DD inclusive
  effectiveTo              String?       @map("effective_to") // YYYY-MM-DD inclusive, null = open-ended
  isActive                 Boolean       @default(false) @map("is_active")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  createdBy                String?       @map("created_by")
  updatedBy                String?       @map("updated_by")

  @@index([leaveTypeId, isActive])
  @@index([organizationId])
  @@index([employmentType])
  @@index([effectiveFrom])
  @@map("leave_policies")
}

// Reserved for later Phase 2 tasks (not created yet):
//   leave_entitlements, leave_ledger, leave_requests, notifications, notification_deliveries
