// HR Enterprise Platform — Phase 1 schema
//
// Conventions
//  - Table / column names are snake_case via @@map / @map (portable to PostgreSQL).
//  - ids are cuid strings (no guessable sequential ids).
//  - Enum-like values are TEXT columns; the allowed values live in @hr/shared (kept portable across providers).
//  - No hard deletes for master data: is_active / employment_status flags instead.
//
// Database: PostgreSQL is the canonical development + integration database since Task 10.5.
// prisma/migrations holds the PostgreSQL history (baseline generated from this model); the SQLite history of
// Tasks 1–10 is archived in prisma/migrations-sqlite-archive and must never be applied to PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// SECURITY / IDENTITY
// =====================================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  employeeId   String?   @unique @map("employee_id")
  employee     Employee? @relation(fields: [employeeId], references: [id])
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  userRoles UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]

  // workflow (Phase 2)
  workflowDefinitionSteps       WorkflowDefinitionStep[]
  workflowRequests              WorkflowInstance[]             @relation("WorkflowRequesterUser")
  workflowApproverSteps         WorkflowInstanceStep[]         @relation("WorkflowStepApproverUser")
  workflowActedSteps            WorkflowInstanceStep[]         @relation("WorkflowStepActedBy")
  workflowActions               WorkflowAction[]
  leaveLedgerEntries            LeaveLedger[]
  leaveRequestsCreated          LeaveRequest[]
  onboardingImports             OnboardingImportRun[]
  passwordResetTokens           PasswordResetToken[]           @relation("PasswordResetSubject")
  passwordResetsIssued          PasswordResetToken[]           @relation("PasswordResetIssuer")
  privacyRequestsSubject        PrivacyRequest[]               @relation("PrivacySubjectUser")
  privacyRequestsCreated        PrivacyRequest[]               @relation("PrivacyRequestCreator")
  privacyRequestsAssigned       PrivacyRequest[]               @relation("PrivacyRequestAssignee")
  attendanceSchedules           AttendanceSchedule[]           @relation("AttendanceScheduleCreator")
  attendanceClockEvents         AttendanceClockEvent[]         @relation("AttendanceClockCreator")
  attendanceCorrections         AttendanceCorrection[]         @relation("AttendanceCorrectionCreator")
  overtimeRequestsCreated       OvertimeRequest[]              @relation("OvertimeRequestCreator")
  compensationsCreated          EmployeeCompensation[]         @relation("CompensationCreator")
  payItemsCreated               EmployeePayItem[]              @relation("PayItemCreator")
  payrollRunsStarted            PayrollRun[]                   @relation("PayrollRunStarter")
  payrollRunsClosed             PayrollRun[]                   @relation("PayrollRunCloser")
  performanceReviews            PerformancePlan[]              @relation("PerformancePlanReviewerUser")
  competencyReviews             CompetencyAssessment[]         @relation("CompetencyAssessmentReviewerUser")
  developmentPlansManaged       IndividualDevelopmentPlan[]    @relation("IdpManagerUser")
  employeeRelationCasesAssigned EmployeeRelationCase[]         @relation("ErCaseAssignee")
  interviewerAssignments        RecruitmentInterviewer[]
  interviewFeedback             RecruitmentInterviewFeedback[]
  disciplinaryAcknowledgements  DisciplinaryAcknowledgement[]
  notifications                 Notification[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique // EMPLOYEE | MANAGER | HR | HR_ADMIN | EXECUTIVE | SYSTEM_ADMIN
  name        String
  description String?
  dataScope   String   @default("SELF") @map("data_scope") // SELF | TEAM | ALL
  isSystem    Boolean  @default(false) @map("is_system") // system roles cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles               UserRole[]
  rolePermissions         RolePermission[]
  workflowDefinitionSteps WorkflowDefinitionStep[] // reserved for ROLE approvers (not enabled)

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique // e.g. employees.update
  module      String
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// DB-backed sessions. Only the SHA-256 hash of the cookie token is stored.
/// csrf_token is a separate random value (synchronizer token) — never the session token.
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  csrfToken String   @map("csrf_token")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// =====================================================================
// ORGANIZATION
// =====================================================================

model Organization {
  id                String        @id @default(cuid())
  code              String        @unique
  name              String
  /// IANA timezone (e.g. Asia/Bangkok) — source of truth for business "today" in this organization
  timezone          String        @default("Asia/Bangkok")
  /// Work calendar used for leave/attendance calculations unless an employee-level assignment exists (Phase 2B)
  defaultCalendarId String?       @map("default_calendar_id")
  defaultCalendar   WorkCalendar? @relation("OrganizationDefaultCalendar", fields: [defaultCalendarId], references: [id])
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  departments          Department[]
  employees            Employee[]
  workCalendars        WorkCalendar[]           @relation("OrganizationCalendars")
  leavePolicies        LeavePolicy[]
  attendanceShifts     AttendanceShift[]
  overtimePolicies     OvertimePolicy[]
  overtimeRequests     OvertimeRequest[]
  payrollPolicies      PayrollPolicy[]
  payrollPeriods       PayrollPeriod[]
  performanceCycles    PerformanceCycle[]
  recruitmentPolicies  RecruitmentPolicy[]
  requisitions         RecruitmentRequisition[]
  careerPaths          CareerPath[]
  documents            Document[]
  talentReviewCycles   TalentReviewCycle[]
  talentPools          TalentPool[]
  performanceKpis      PerformanceKpi[]
  trainingSessions     TrainingSession[]
  disciplinaryPolicies DisciplinaryPolicy[]

  @@map("organizations")
}

model Department {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  parentId       String?      @map("parent_id") // sub-department support
  parent         Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentTree")
  code           String
  name           String
  headEmployeeId String?      @map("head_employee_id")
  headEmployee   Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  positions         Position[]
  employees         Employee[]
  employeePositions EmployeePosition[]
  successionPlans   SuccessionPlan[]

  @@unique([organizationId, code])
  @@index([parentId])
  @@map("departments")
}

/// Job = job title / level template, independent of department (e.g. "Manager", level 3).
model Job {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  level       Int      @default(1)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  positions              Position[]
  competencyRequirements JobCompetencyRequirement[]
  requisitions           RecruitmentRequisition[]
  openings               RecruitmentOpening[]
  careerStepsFrom        CareerPathStep[]           @relation("CareerStepFrom")
  careerStepsTo          CareerPathStep[]           @relation("CareerStepTo")

  @@map("jobs")
}

/// Position = a concrete seat inside a department (e.g. "Sales Manager" in Sales).
model Position {
  id           String     @id @default(cuid())
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  jobId        String?    @map("job_id")
  job          Job?       @relation(fields: [jobId], references: [id])
  code         String     @unique
  title        String
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  employees         Employee[]
  employeePositions EmployeePosition[]
  successionPlans   SuccessionPlan[]

  @@index([departmentId])
  @@map("positions")
}

// =====================================================================
// EMPLOYEE MASTER  (single source of truth — every module references employees.id)
// =====================================================================

model Employee {
  id              String    @id @default(cuid())
  employeeCode    String    @unique @map("employee_code")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  nickname        String?
  email           String    @unique
  phone           String?
  hireDate        DateTime  @map("hire_date")
  terminationDate DateTime? @map("termination_date")

  // current assignment (denormalized for fast queries; history in employee_positions / employee_managers)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  departmentId   String       @map("department_id")
  department     Department   @relation(fields: [departmentId], references: [id])
  positionId     String       @map("position_id")
  position       Position     @relation(fields: [positionId], references: [id])
  managerId      String?      @map("manager_id")
  manager        Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports  Employee[]   @relation("EmployeeManager")

  employmentType   String @default("FULL_TIME") @map("employment_type") // FULL_TIME | PART_TIME | CONTRACT | INTERN
  employmentStatus String @default("ACTIVE") @map("employment_status") // ACTIVE | INACTIVE | TERMINATED

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") // users.id
  updatedBy String?  @map("updated_by") // users.id

  user                         User?
  headOfDepartments            Department[]                  @relation("DepartmentHead")
  positionHistory              EmployeePosition[]
  managerHistory               EmployeeManager[]             @relation("ManagerHistoryEmployee")
  managedHistory               EmployeeManager[]             @relation("ManagerHistoryManager")
  workflowRequests             WorkflowInstance[]            @relation("WorkflowRequesterEmployee")
  workflowApproverSteps        WorkflowInstanceStep[]        @relation("WorkflowStepApproverEmployee")
  leaveEntitlements            LeaveEntitlement[]
  leaveRequests                LeaveRequest[]
  privacyRequests              PrivacyRequest[]
  attendanceSchedules          AttendanceSchedule[]
  attendanceClockEvents        AttendanceClockEvent[]
  attendanceRecords            AttendanceRecord[]
  attendanceCorrections        AttendanceCorrection[]
  overtimeRequests             OvertimeRequest[]
  compensations                EmployeeCompensation[]
  payItems                     EmployeePayItem[]
  payrollResults               PayrollResult[]
  performancePlans             PerformancePlan[]             @relation("PerformancePlanEmployee")
  performanceReviews           PerformancePlan[]             @relation("PerformancePlanReviewer")
  competencyAssessments        CompetencyAssessment[]        @relation("CompetencyAssessmentEmployee")
  competencyReviews            CompetencyAssessment[]        @relation("CompetencyAssessmentReviewer")
  trainingNeeds                TrainingNeed[]
  trainingEnrollments          TrainingEnrollment[]
  developmentPlans             IndividualDevelopmentPlan[]   @relation("IdpEmployee")
  developmentPlansManaged      IndividualDevelopmentPlan[]   @relation("IdpManager")
  employeeRelationCases        EmployeeRelationCase[]
  disciplinaryActions          DisciplinaryAction[]
  hiringRequisitions           RecruitmentRequisition[]      @relation("RequisitionHiringManager")
  talentReviews                TalentReview[]                @relation("TalentReviewEmployee")
  talentReviewsAsReviewer      TalentReview[]                @relation("TalentReviewReviewer")
  talentPoolMemberships        TalentPoolMember[]
  successionNominations        SuccessionCandidate[]
  ownedDocuments               Document[]                    @relation("DocumentOwner")
  interviewerAssignments       RecruitmentInterviewer[]
  disciplinaryAcknowledgements DisciplinaryAcknowledgement[]

  @@index([departmentId])
  @@index([managerId])
  @@index([employmentStatus])
  @@map("employees")
}

/// Position assignment history. end_date NULL = current.
model EmployeePosition {
  id           String     @id @default(cuid())
  employeeId   String     @map("employee_id")
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  positionId   String     @map("position_id")
  position     Position   @relation(fields: [positionId], references: [id])
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  startDate    DateTime   @map("start_date")
  endDate      DateTime?  @map("end_date")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("employee_positions")
}

/// Manager assignment history. end_date NULL = current.
model EmployeeManager {
  id         String    @id @default(cuid())
  employeeId String    @map("employee_id")
  employee   Employee  @relation("ManagerHistoryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  managerId  String    @map("manager_id")
  manager    Employee  @relation("ManagerHistoryManager", fields: [managerId], references: [id])
  startDate  DateTime  @map("start_date")
  endDate    DateTime? @map("end_date")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("employee_managers")
}

// =====================================================================
// SHARED SERVICES
// =====================================================================

/// Field-level audit trail. old_value / new_value are JSON text (only changed fields, sensitive keys redacted).
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id") // actor; null for system actions
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. UPDATE_EMPLOYEE
  module     String // e.g. employees
  recordType String   @map("record_type") // e.g. Employee
  recordId   String?  @map("record_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // list is always ordered by created_at desc and filtered by one of: actor, module, action, record
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@index([action, createdAt])
  @@index([recordType, recordId])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("system_settings")
}

// =====================================================================
// WORKFLOW ENGINE (shared service, Phase 2)
// =====================================================================

/// MASTER, versioned. A (code, version) row is immutable once created; "editing" = new version. One active version per code (enforced in service).
model WorkflowDefinition {
  id          String    @id @default(cuid())
  code        String
  version     Int
  name        String
  description String?
  module      String // business module key, e.g. leave
  entityType  String // business entity, e.g. LeaveRequest
  isActive    Boolean   @default(false) @map("is_active")
  activatedAt DateTime? @map("activated_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")

  steps     WorkflowDefinitionStep[]
  instances WorkflowInstance[]

  @@unique([code, version])
  @@index([code, isActive])
  @@map("workflow_definitions")
}

/// MASTER. Sequential steps 1..n of a definition version.
model WorkflowDefinitionStep {
  id             String             @id @default(cuid())
  definitionId   String             @map("definition_id")
  definition     WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  stepOrder      Int                @map("step_order")
  name           String
  approverType   String             @map("approver_type") // DIRECT_MANAGER | DEPARTMENT_HEAD | SPECIFIC_USER | ROLE (reserved)
  approverUserId String?            @map("approver_user_id")
  approverUser   User?              @relation(fields: [approverUserId], references: [id])
  approverRoleId String?            @map("approver_role_id") // reserved, never set in Phase 2
  approverRole   Role?              @relation(fields: [approverRoleId], references: [id])
  onSelf         String             @default("FAIL") @map("on_self") // FAIL | SKIP
  onUnresolved   String             @default("FAIL") @map("on_unresolved") // FAIL | SKIP

  @@unique([definitionId, stepOrder])
  @@map("workflow_definition_steps")
}

/// TRANSACTION. One running/finished workflow for a business entity (module, entityType, entityId).
model WorkflowInstance {
  id                  String             @id @default(cuid())
  definitionId        String             @map("definition_id") // the exact version used
  definition          WorkflowDefinition @relation(fields: [definitionId], references: [id])
  module              String
  entityType          String             @map("entity_type")
  entityId            String             @map("entity_id")
  requesterEmployeeId String             @map("requester_employee_id")
  requesterEmployee   Employee           @relation("WorkflowRequesterEmployee", fields: [requesterEmployeeId], references: [id])
  requesterUserId     String?            @map("requester_user_id")
  requesterUser       User?              @relation("WorkflowRequesterUser", fields: [requesterUserId], references: [id])
  status              String             @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  currentStepOrder    Int?               @map("current_step_order")
  submittedAt         DateTime           @default(now()) @map("submitted_at")
  completedAt         DateTime?          @map("completed_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  steps   WorkflowInstanceStep[]
  actions WorkflowAction[]

  @@index([module, entityType, entityId])
  @@index([requesterEmployeeId])
  @@index([status])
  @@map("workflow_instances")
}

/// SNAPSHOT. Steps copied from the definition at submit time with the approver resolved then; later org changes never touch these rows.
model WorkflowInstanceStep {
  id                 String           @id @default(cuid())
  instanceId         String           @map("instance_id")
  instance           WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepOrder          Int              @map("step_order")
  name               String
  approverType       String           @map("approver_type")
  approverEmployeeId String?          @map("approver_employee_id")
  approverEmployee   Employee?        @relation("WorkflowStepApproverEmployee", fields: [approverEmployeeId], references: [id])
  approverUserId     String?          @map("approver_user_id")
  approverUser       User?            @relation("WorkflowStepApproverUser", fields: [approverUserId], references: [id])
  approverRoleId     String?          @map("approver_role_id") // reserved
  status             String           @default("WAITING") // WAITING | PENDING | APPROVED | REJECTED | SKIPPED | CANCELLED
  skipReason         String?          @map("skip_reason") // SELF | UNRESOLVED
  actedByUserId      String?          @map("acted_by_user_id") // kept separate from approverUserId (future delegation)
  actedBy            User?            @relation("WorkflowStepActedBy", fields: [actedByUserId], references: [id])
  actedAt            DateTime?        @map("acted_at")
  comment            String?

  @@unique([instanceId, stepOrder])
  @@index([approverUserId, status])
  @@map("workflow_instance_steps")
}

/// HISTORY, append-only. SUBMIT / APPROVE / REJECT / CANCEL with actor and comment.
model WorkflowAction {
  id          String           @id @default(cuid())
  instanceId  String           @map("instance_id")
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepOrder   Int?             @map("step_order")
  action      String
  actorUserId String?          @map("actor_user_id")
  actor       User?            @relation(fields: [actorUserId], references: [id])
  comment     String?
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([instanceId, createdAt])
  @@map("workflow_actions")
}

// =====================================================================
// WORK CALENDAR (shared HRM master — reused by Leave and, later, Attendance)
// =====================================================================

/// MASTER. Working weekdays of an organization calendar; working_days is a JSON array of MON..SUN (validated + normalized by the service).
model WorkCalendar {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation("OrganizationCalendars", fields: [organizationId], references: [id])
  code           String
  name           String
  workingDays    String       @map("working_days") // JSON text, e.g. ["MON","TUE","WED","THU","FRI"]
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdBy      String?      @map("created_by")
  updatedBy      String?      @map("updated_by")

  holidays       Holiday[]
  defaultForOrgs Organization[] @relation("OrganizationDefaultCalendar")

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("work_calendars")
}

/// MASTER. Holiday dates (YYYY-MM-DD) of a calendar; may fall on non-working days.
model Holiday {
  id         String       @id @default(cuid())
  calendarId String       @map("calendar_id")
  calendar   WorkCalendar @relation(fields: [calendarId], references: [id])
  date       String // business date YYYY-MM-DD
  name       String
  isActive   Boolean      @default(true) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  createdBy  String?      @map("created_by")
  updatedBy  String?      @map("updated_by")

  @@unique([calendarId, date])
  @@map("holidays")
}

// =====================================================================
// LEAVE — MASTER DATA (Phase 2, Task 9)
// =====================================================================

/// MASTER (semantic only). Business rules live on leave_policies.
model LeaveType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  policies     LeavePolicy[]
  entitlements LeaveEntitlement[]
  requests     LeaveRequest[]

  @@map("leave_types")
}

/// MASTER. Rules for a leave type in an (organization, employmentType) context; null selectors = ANY.
/// policyId is a historical identity: entitlements/requests will reference it (guard against silent rule edits comes with those tables).
model LeavePolicy {
  id                       String        @id @default(cuid())
  name                     String
  leaveTypeId              String        @map("leave_type_id")
  leaveType                LeaveType     @relation(fields: [leaveTypeId], references: [id])
  organizationId           String?       @map("organization_id")
  organization             Organization? @relation(fields: [organizationId], references: [id])
  employmentType           String?       @map("employment_type") // FULL_TIME | PART_TIME | CONTRACT | INTERN | null = any
  annualUnits              Float         @map("annual_units") // days, multiples of 0.5
  isPaid                   Boolean       @default(true) @map("is_paid")
  requiresReason           Boolean       @default(false) @map("requires_reason")
  requiresAttachment       Boolean       @default(false) @map("requires_attachment")
  allowHalfDay             Boolean       @default(true) @map("allow_half_day")
  allowNegativeBalance     Boolean       @default(false) @map("allow_negative_balance")
  maxConsecutiveDays       Int?          @map("max_consecutive_days")
  minNoticeDays            Int?          @map("min_notice_days")
  allowBackdate            Boolean       @default(false) @map("allow_backdate")
  carryForwardMaxUnits     Float         @default(0) @map("carry_forward_max_units")
  carryForwardExpiryMonths Int?          @map("carry_forward_expiry_months")
  workflowDefinitionCode   String?       @map("workflow_definition_code") // must be an active workflow for leave/LEAVE_REQUEST when the policy is active
  effectiveFrom            String        @map("effective_from") // YYYY-MM-DD inclusive
  effectiveTo              String?       @map("effective_to") // YYYY-MM-DD inclusive, null = open-ended
  isActive                 Boolean       @default(false) @map("is_active")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  createdBy                String?       @map("created_by")
  updatedBy                String?       @map("updated_by")

  entitlements LeaveEntitlement[]
  requests     LeaveRequest[]

  @@index([leaveTypeId, isActive])
  @@index([organizationId])
  @@index([employmentType])
  @@index([effectiveFrom])
  @@map("leave_policies")
}

// =====================================================================
// LEAVE — ENTITLEMENT + LEDGER (Phase 2, Task 10)
// =====================================================================

/// TRANSACTION (cached summary). granted/carriedForward/adjustment/reserved/used are DERIVED from leave_ledger and
/// recomputed inside every ledger-writing transaction — never incremented blindly. policyId = policy used to grant (historical identity).
model LeaveEntitlement {
  id                 String      @id @default(cuid())
  employeeId         String      @map("employee_id")
  employee           Employee    @relation(fields: [employeeId], references: [id])
  leaveTypeId        String      @map("leave_type_id")
  leaveType          LeaveType   @relation(fields: [leaveTypeId], references: [id])
  policyId           String      @map("policy_id")
  policy             LeavePolicy @relation(fields: [policyId], references: [id])
  policyResolvedDate String      @map("policy_resolved_date") // YYYY-MM-DD (= periodStart in Phase 2)
  periodStart        String      @map("period_start") // YYYY-MM-DD inclusive
  periodEnd          String      @map("period_end") // YYYY-MM-DD inclusive
  granted            Float       @default(0)
  carriedForward     Float       @default(0) @map("carried_forward")
  adjustment         Float       @default(0)
  reserved           Float       @default(0)
  used               Float       @default(0)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  createdByUserId    String?     @map("created_by_user_id")

  ledger   LeaveLedger[]
  requests LeaveRequest[]

  @@unique([employeeId, leaveTypeId, periodStart])
  @@index([employeeId, leaveTypeId])
  @@index([periodStart, periodEnd])
  @@index([policyId])
  @@map("leave_entitlements")
}

/// HISTORY, append-only — SOURCE OF TRUTH for balances. Sign convention in @hr/shared leave-ledger.ts.
model LeaveLedger {
  id              String           @id @default(cuid())
  entitlementId   String           @map("entitlement_id")
  entitlement     LeaveEntitlement @relation(fields: [entitlementId], references: [id])
  entryType       String           @map("entry_type") // GRANT | CARRY_FORWARD | ADJUSTMENT | RESERVE | RELEASE | USE | REFUND
  units           Float // signed, multiple of 0.5, never 0
  referenceType   String?          @map("reference_type") // e.g. LeaveRequest
  referenceId     String?          @map("reference_id")
  operationKey    String           @unique @map("operation_key") // idempotency: grant:<id>, leave:<requestId>:reserve, adj:<cuid>
  note            String?
  createdByUserId String?          @map("created_by_user_id")
  createdBy       User?            @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([entitlementId, createdAt])
  @@map("leave_ledger")
}

/// Leave request lifecycle DRAFT → PENDING → APPROVED | REJECTED | CANCELLED (Task 11 service). Snapshot fields are set at
/// SUBMIT and never recalculated: policyId = REQUEST policy (resolved from the employee's org/type at startDate — may differ
/// from the entitlement's grant policy), calendarId + units = calendar in force at submit, org/dept/position = assignment then.
model LeaveRequest {
  id                 String            @id @default(cuid())
  employeeId         String            @map("employee_id")
  employee           Employee          @relation(fields: [employeeId], references: [id])
  leaveTypeId        String            @map("leave_type_id")
  leaveType          LeaveType         @relation(fields: [leaveTypeId], references: [id])
  startDate          String            @map("start_date") // YYYY-MM-DD
  endDate            String            @map("end_date") // YYYY-MM-DD
  startPart          String            @default("FULL") @map("start_part") // FULL | AM | PM
  endPart            String            @default("FULL") @map("end_part") // FULL | AM | PM
  units              Float             @default(0) // server-calculated; frozen at submit
  reason             String?
  attachmentRef      String?           @map("attachment_ref") // opaque reference only (no document service yet)
  status             String            @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED | CANCELLED
  // snapshot on submit
  entitlementId      String?           @map("entitlement_id")
  entitlement        LeaveEntitlement? @relation(fields: [entitlementId], references: [id])
  policyId           String?           @map("policy_id")
  policy             LeavePolicy?      @relation(fields: [policyId], references: [id])
  calendarId         String?           @map("calendar_id")
  organizationId     String?           @map("organization_id")
  departmentId       String?           @map("department_id")
  positionId         String?           @map("position_id")
  workflowInstanceId String?           @unique @map("workflow_instance_id")
  submittedAt        DateTime?         @map("submitted_at")
  approvedAt         DateTime?         @map("approved_at")
  rejectedAt         DateTime?         @map("rejected_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  createdByUserId    String            @map("created_by_user_id")
  createdBy          User              @relation(fields: [createdByUserId], references: [id])

  @@index([employeeId, status])
  @@index([employeeId, startDate, endDate])
  @@index([status, startDate])
  @@index([leaveTypeId])
  @@index([organizationId, status])
  @@index([policyId])
  @@map("leave_requests")
}

/// In-app notification for ONE user. Immutable once written except `readAt`; the inbox is the recipient's own data
/// (no permission code — every query filters by userId). `dedupeKey` makes publishing idempotent inside a retried
/// business transaction. Never holds leave reasons, attachment references, approval comments, policy or ledger details.
model Notification {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id])
  type             String // APPROVAL_REQUIRED | LEAVE_SUBMITTED | LEAVE_APPROVED | LEAVE_REJECTED | LEAVE_CANCELLED (reserved)
  title            String
  body             String
  sourceModule     String?   @map("source_module") // e.g. leave
  sourceEntityType String?   @map("source_entity_type") // e.g. LEAVE_REQUEST
  sourceEntityId   String?   @map("source_entity_id")
  data             Json? // minimal ids for deep-linking only
  dedupeKey        String    @map("dedupe_key") // deterministic per event, e.g. leave:<id>:approved
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([sourceModule, sourceEntityType, sourceEntityId])
  @@map("notifications")
}

/// Outbox foundation. Task 13 writes only IN_APP rows (SENT at publish time, in the business transaction).
/// EMAIL/LINE/LARK/PUSH rows arrive with recipient preferences + a worker; no external call ever runs inside a transaction.
model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String       @map("notification_id")
  notification   Notification @relation(fields: [notificationId], references: [id])
  channel        String // IN_APP | EMAIL | LINE | LARK | PUSH
  status         String // PENDING | SENT | FAILED
  attempts       Int          @default(0)
  lastError      String?      @map("last_error")
  sentAt         DateTime?    @map("sent_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([notificationId, channel])
  @@index([status, channel])
  @@map("notification_deliveries")
}

/// METADATA ONLY for a committed customer-onboarding import. The workbook itself is never stored (it is full of PII and
/// the entities it created are the real record); this row exists to answer "what was imported, by whom, when" and to
/// make re-submitting the same file a no-op rather than a duplicate import.
model OnboardingImportRun {
  id                String   @id @default(cuid())
  fileName          String   @map("file_name") // sanitised basename, never a path
  fileHash          String   @unique @map("file_hash") // SHA-256 of the workbook: the idempotency key
  templateVersion   Int      @map("template_version")
  organizationCount Int      @default(0) @map("organization_count")
  departmentCount   Int      @default(0) @map("department_count")
  jobCount          Int      @default(0) @map("job_count")
  positionCount     Int      @default(0) @map("position_count")
  employeeCount     Int      @default(0) @map("employee_count")
  createdByUserId   String   @map("created_by_user_id")
  createdBy         User     @relation(fields: [createdByUserId], references: [id])
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("onboarding_import_runs")
}

/// One-time password reset. Only the SHA-256 hash is stored, exactly like session tokens: the raw token is shown to
/// the issuing administrator once and never again, so a database copy cannot be turned back into a working link.
model PasswordResetToken {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  user            User      @relation("PasswordResetSubject", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdByUserId String?   @map("created_by_user_id")
  createdBy       User?     @relation("PasswordResetIssuer", fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Register of privacy requests from data subjects. A record of what was asked and what the organization decided —
/// the system performs no erasure and makes no legal judgement; retention and legal basis are customer policy.
model PrivacyRequest {
  id               String    @id @default(cuid())
  requestType      String    @map("request_type") // ACCESS | EXPORT | CORRECTION | DELETION | RESTRICTION | OTHER
  status           String    @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | REJECTED
  employeeId       String?   @map("employee_id")
  employee         Employee? @relation(fields: [employeeId], references: [id])
  userId           String?   @map("user_id")
  user             User?     @relation("PrivacySubjectUser", fields: [userId], references: [id])
  requestedAt      DateTime  @default(now()) @map("requested_at")
  dueAt            DateTime? @map("due_at")
  completedAt      DateTime? @map("completed_at")
  notes            String? // may contain sensitive free text: never logged, never in the list response
  assignedToUserId String?   @map("assigned_to_user_id")
  assignedTo       User?     @relation("PrivacyRequestAssignee", fields: [assignedToUserId], references: [id])
  createdByUserId  String    @map("created_by_user_id")
  createdBy        User      @relation("PrivacyRequestCreator", fields: [createdByUserId], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status, requestedAt])
  @@index([employeeId])
  @@map("privacy_requests")
}

// ---------------------------------------------------------------------------
// Time & Attendance (Task 20)
// ---------------------------------------------------------------------------

/// A working pattern: when the day starts and ends, how long the unpaid break is, and how much lateness is forgiven.
/// Times are `HH:mm` wall clock in the organization's timezone; the instants they mean are computed per date.
model AttendanceShift {
  id                     String       @id @default(cuid())
  organizationId         String       @map("organization_id")
  organization           Organization @relation(fields: [organizationId], references: [id])
  code                   String
  name                   String
  startTime              String       @map("start_time") // HH:mm
  endTime                String       @map("end_time") // HH:mm
  breakMinutes           Int          @default(0) @map("break_minutes")
  lateGraceMinutes       Int          @default(0) @map("late_grace_minutes")
  earlyLeaveGraceMinutes Int          @default(0) @map("early_leave_grace_minutes")
  /// Derived from the times at write time (end <= start), stored so queries need not recompute it.
  isOvernight            Boolean      @default(false) @map("is_overnight")
  isActive               Boolean      @default(true) @map("is_active")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  schedules AttendanceSchedule[]
  records   AttendanceRecord[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("attendance_shifts")
}

/// What one employee is expected to work on one date. Leave is deliberately NOT stored here: it is read from the
/// approved leave requests when attendance is calculated, so approving or cancelling leave never leaves a stale row.
model AttendanceSchedule {
  id              String           @id @default(cuid())
  employeeId      String           @map("employee_id")
  employee        Employee         @relation(fields: [employeeId], references: [id])
  date            String // YYYY-MM-DD
  shiftId         String?          @map("shift_id")
  shift           AttendanceShift? @relation(fields: [shiftId], references: [id])
  dayType         String // WORK | OFF | HOLIDAY
  source          String           @default("MANUAL") // DEFAULT | MANUAL
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  createdByUserId String?          @map("created_by_user_id")
  createdBy       User?            @relation("AttendanceScheduleCreator", fields: [createdByUserId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance_schedules")
}

/// Raw clock events, append-only. Nothing ever updates or deletes a row here: a correction records what should have
/// been, next to what actually happened, and the derived record is recomputed from both.
model AttendanceClockEvent {
  id              String   @id @default(cuid())
  employeeId      String   @map("employee_id")
  employee        Employee @relation(fields: [employeeId], references: [id])
  eventType       String   @map("event_type") // CLOCK_IN | CLOCK_OUT
  occurredAt      DateTime @map("occurred_at") // UTC instant
  attendanceDate  String   @map("attendance_date") // business date the event belongs to
  source          String   @default("WEB") // WEB | ADMIN | IMPORT | API
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")
  createdByUserId String?  @map("created_by_user_id")
  createdBy       User?    @relation("AttendanceClockCreator", fields: [createdByUserId], references: [id])

  @@index([employeeId, occurredAt])
  @@index([employeeId, attendanceDate])
  @@map("attendance_clock_events")
}

/// One derived day per employee. Always recomputable from schedule + calendar + leave + clock events + an approved
/// correction, so it is a cache with a unique key, never a second source of truth.
model AttendanceRecord {
  id                String           @id @default(cuid())
  employeeId        String           @map("employee_id")
  employee          Employee         @relation(fields: [employeeId], references: [id])
  attendanceDate    String           @map("attendance_date")
  shiftId           String?          @map("shift_id")
  shift             AttendanceShift? @relation(fields: [shiftId], references: [id])
  dayType           String           @map("day_type")
  scheduledStart    DateTime?        @map("scheduled_start")
  scheduledEnd      DateTime?        @map("scheduled_end")
  firstClockIn      DateTime?        @map("first_clock_in")
  lastClockOut      DateTime?        @map("last_clock_out")
  workMinutes       Int              @default(0) @map("work_minutes")
  lateMinutes       Int              @default(0) @map("late_minutes")
  earlyLeaveMinutes Int              @default(0) @map("early_leave_minutes")
  /// Worked beyond the shift. Informational: overtime is not calculated or paid in this release.
  extraMinutes      Int              @default(0) @map("extra_minutes")
  leaveUnits        Float            @default(0) @map("leave_units")
  status            String
  /// The approved correction whose times were used, if any.
  correctionId      String?          @map("correction_id")
  calculatedAt      DateTime         @map("calculated_at")

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate, status])
  @@map("attendance_records")
}

/// "I forgot to clock out" — an employee's request to record different times for a day. Approval goes through the
/// shared workflow engine; approving it never rewrites a raw clock event.
model AttendanceCorrection {
  id                 String    @id @default(cuid())
  employeeId         String    @map("employee_id")
  employee           Employee  @relation(fields: [employeeId], references: [id])
  attendanceDate     String    @map("attendance_date")
  requestedClockIn   DateTime? @map("requested_clock_in")
  requestedClockOut  DateTime? @map("requested_clock_out")
  reason             String
  status             String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  workflowInstanceId String?   @unique @map("workflow_instance_id")
  submittedAt        DateTime? @map("submitted_at")
  decidedAt          DateTime? @map("decided_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdByUserId    String    @map("created_by_user_id")
  createdBy          User      @relation("AttendanceCorrectionCreator", fields: [createdByUserId], references: [id])

  @@index([employeeId, attendanceDate])
  @@index([status, attendanceDate])
  @@map("attendance_corrections")
}

// ---------------------------------------------------------------------------
// Overtime (Task 21)
// ---------------------------------------------------------------------------

/// What overtime is worth on each kind of day, and the limits on a claim. Multipliers are ratios, not money: this
/// release calculates no monetary overtime — payroll (Task 22) multiplies approved minutes by a salary basis.
model OvertimePolicy {
  id                           String       @id @default(cuid())
  organizationId               String       @map("organization_id")
  organization                 Organization @relation(fields: [organizationId], references: [id])
  name                         String
  effectiveFrom                String       @map("effective_from") // YYYY-MM-DD
  effectiveTo                  String?      @map("effective_to")
  workdayMultiplier            Float        @map("workday_multiplier")
  offDayMultiplier             Float        @map("off_day_multiplier")
  holidayMultiplier            Float        @map("holiday_multiplier")
  /// A claim below this is not overtime. A threshold, never a rounding rule.
  minimumEligibleMinutes       Int?         @map("minimum_eligible_minutes")
  maximumApprovedMinutesPerDay Int?         @map("maximum_approved_minutes_per_day")
  workflowDefinitionCode       String       @map("workflow_definition_code")
  isActive                     Boolean      @default(true) @map("is_active")
  createdAt                    DateTime     @default(now()) @map("created_at")
  updatedAt                    DateTime     @updatedAt @map("updated_at")

  requests OvertimeRequest[]

  @@index([organizationId, isActive, effectiveFrom])
  @@map("overtime_policies")
}

/// One claim for one day. Everything that decides what it is eventually worth — day type, eligible minutes, the
/// multiplier and the policy — is snapshotted when it is submitted, so a later policy edit cannot rewrite history.
model OvertimeRequest {
  id                      String          @id @default(cuid())
  employeeId              String          @map("employee_id")
  employee                Employee        @relation(fields: [employeeId], references: [id])
  attendanceDate          String          @map("attendance_date")
  claimedMinutes          Int             @map("claimed_minutes")
  /// What the day allowed at submit. Kept so a later change in attendance is visible rather than silent.
  eligibleMinutesSnapshot Int?            @map("eligible_minutes_snapshot")
  approvedMinutes         Int?            @map("approved_minutes")
  dayType                 String?         @map("day_type") // WORKDAY | OFF_DAY | HOLIDAY
  rateMultiplierSnapshot  Float?          @map("rate_multiplier_snapshot")
  policyId                String?         @map("policy_id")
  policy                  OvertimePolicy? @relation(fields: [policyId], references: [id])
  reason                  String?
  status                  String          @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED | CANCELLED
  workflowInstanceId      String?         @unique @map("workflow_instance_id")
  submittedAt             DateTime?       @map("submitted_at")
  approvedAt              DateTime?       @map("approved_at")
  rejectedAt              DateTime?       @map("rejected_at")
  cancelledAt             DateTime?       @map("cancelled_at")
  /// Snapshot of where the employee sat when the claim was submitted (reporting keeps working after a transfer).
  organizationId          String?         @map("organization_id")
  organization            Organization?   @relation(fields: [organizationId], references: [id])
  departmentId            String?         @map("department_id")
  positionId              String?         @map("position_id")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  createdByUserId         String          @map("created_by_user_id")
  createdBy               User            @relation("OvertimeRequestCreator", fields: [createdByUserId], references: [id])

  @@index([employeeId, attendanceDate])
  @@index([employeeId, status])
  @@index([attendanceDate, status])
  @@index([organizationId, attendanceDate])
  @@index([policyId])
  @@map("overtime_requests")
}

// ---------------------------------------------------------------------------
// Payroll (Task 22)
// ---------------------------------------------------------------------------
// Money is `Decimal` (PostgreSQL NUMERIC) everywhere — never Float. Amounts carry two decimal places; derived rates
// carry six, because a minute rate divided three ways and multiplied back must not drift. Nothing in this schema
// stores a statutory amount: withholding tax, social security and provident fund are absent, not approximated.

/// Salary history. A change closes the current row with an end date and opens a new one, so a payroll run that has
/// already used a salary can never be re-priced by editing it.
model EmployeeCompensation {
  id              String   @id @default(cuid())
  employeeId      String   @map("employee_id")
  employee        Employee @relation(fields: [employeeId], references: [id])
  effectiveFrom   String   @map("effective_from") // YYYY-MM-DD
  effectiveTo     String?  @map("effective_to")
  salaryType      String   @default("MONTHLY") @map("salary_type")
  baseSalary      Decimal  @map("base_salary") @db.Decimal(18, 2)
  currencyCode    String   @default("THB") @map("currency_code")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdByUserId String   @map("created_by_user_id")
  createdBy       User     @relation("CompensationCreator", fields: [createdByUserId], references: [id])

  payrollResults PayrollResult[]

  @@index([employeeId, effectiveFrom])
  @@map("employee_compensations")
}

/// What can appear on a payslip. System components are written by the engine and cannot be deleted or redefined.
model PayComponent {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  type             String // EARNING | DEDUCTION
  calculationType  String   @default("FIXED") @map("calculation_type") // FIXED | MANUAL | SYSTEM
  /// Metadata for a future statutory engine; nothing in this release calculates from it.
  taxable          Boolean  @default(true)
  recurringAllowed Boolean  @default(true) @map("recurring_allowed")
  description      String?
  isSystem         Boolean  @default(false) @map("is_system")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  payItems    EmployeePayItem[]
  resultItems PayrollResultItem[]

  @@index([type, isActive])
  @@map("pay_components")
}

/// A fixed monthly amount attached to one employee — an allowance, or a standing deduction.
model EmployeePayItem {
  id              String       @id @default(cuid())
  employeeId      String       @map("employee_id")
  employee        Employee     @relation(fields: [employeeId], references: [id])
  componentId     String       @map("component_id")
  component       PayComponent @relation(fields: [componentId], references: [id])
  amount          Decimal      @db.Decimal(18, 2)
  effectiveFrom   String       @map("effective_from")
  effectiveTo     String?      @map("effective_to")
  note            String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  createdByUserId String       @map("created_by_user_id")
  createdBy       User         @relation("PayItemCreator", fields: [createdByUserId], references: [id])

  @@index([employeeId, componentId, effectiveFrom])
  @@map("employee_pay_items")
}

/// How an organization turns a monthly salary into a daily and minute rate, and which deductions it applies.
/// Every number here is configuration: nothing assumes 30 days, 26 days or 8 hours.
model PayrollPolicy {
  id                      String       @id @default(cuid())
  organizationId          String       @map("organization_id")
  organization            Organization @relation(fields: [organizationId], references: [id])
  name                    String
  monthlyDivisorDays      Decimal      @map("monthly_divisor_days") @db.Decimal(8, 4)
  dailyWorkHours          Decimal      @map("daily_work_hours") @db.Decimal(8, 4)
  newHireProration        String       @default("CALENDAR_DAYS") @map("new_hire_proration")
  terminationProration    String       @default("CALENDAR_DAYS") @map("termination_proration")
  absenceDeductionEnabled Boolean      @default(true) @map("absence_deduction_enabled")
  lateDeductionEnabled    Boolean      @default(false) @map("late_deduction_enabled")
  workflowDefinitionCode  String       @map("workflow_definition_code")
  effectiveFrom           String       @map("effective_from")
  effectiveTo             String?      @map("effective_to")
  currencyCode            String       @default("THB") @map("currency_code")
  isActive                Boolean      @default(true) @map("is_active")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  periods PayrollPeriod[]

  @@index([organizationId, isActive, effectiveFrom])
  @@map("payroll_policies")
}

/// One month of payroll for one organization. The attendance window is separate from the salary window, because a
/// cut-off on the 20th is normal and assuming otherwise would silently pay the wrong days.
model PayrollPeriod {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  organization   Organization   @relation(fields: [organizationId], references: [id])
  year           Int
  month          Int
  periodStart    String         @map("period_start")
  periodEnd      String         @map("period_end")
  attendanceFrom String         @map("attendance_from")
  attendanceTo   String         @map("attendance_to")
  paymentDate    String?        @map("payment_date")
  status         String         @default("OPEN") // OPEN | PROCESSING | REVIEW | APPROVED | CLOSED
  currencyCode   String         @default("THB") @map("currency_code")
  policyId       String?        @map("policy_id")
  policy         PayrollPolicy? @relation(fields: [policyId], references: [id])
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  runs PayrollRun[]

  @@unique([organizationId, year, month])
  @@index([organizationId, status])
  @@map("payroll_periods")
}

/// A calculation of a period. Rebuilt in place while it is in review; frozen on approval; immutable once closed.
model PayrollRun {
  id                 String        @id @default(cuid())
  periodId           String        @unique @map("period_id")
  period             PayrollPeriod @relation(fields: [periodId], references: [id])
  version            Int           @default(1)
  status             String        @default("REVIEW") // REVIEW | APPROVED | CLOSED
  employeeCount      Int           @default(0) @map("employee_count")
  grossTotal         Decimal       @default(0) @map("gross_total") @db.Decimal(18, 2)
  deductionTotal     Decimal       @default(0) @map("deduction_total") @db.Decimal(18, 2)
  netTotal           Decimal       @default(0) @map("net_total") @db.Decimal(18, 2)
  currencyCode       String        @default("THB") @map("currency_code")
  /// Hash of every input the calculation read. Compared before approval so stale payroll cannot be approved quietly.
  inputFingerprint   String?       @map("input_fingerprint")
  workflowInstanceId String?       @unique @map("workflow_instance_id")
  startedByUserId    String        @map("started_by_user_id")
  startedBy          User          @relation("PayrollRunStarter", fields: [startedByUserId], references: [id])
  startedAt          DateTime      @default(now()) @map("started_at")
  calculatedAt       DateTime?     @map("calculated_at")
  approvedAt         DateTime?     @map("approved_at")
  closedAt           DateTime?     @map("closed_at")
  closedByUserId     String?       @map("closed_by_user_id")
  closedBy           User?         @relation("PayrollRunCloser", fields: [closedByUserId], references: [id])
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  results PayrollResult[]

  @@index([status])
  @@map("payroll_runs")
}

/// One employee's payroll for one run, with the identity and inputs snapshotted so a payslip never changes meaning.
model PayrollResult {
  id                String                @id @default(cuid())
  runId             String                @map("run_id")
  run               PayrollRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId        String                @map("employee_id")
  employee          Employee              @relation(fields: [employeeId], references: [id])
  employeeCode      String                @map("employee_code")
  employeeName      String                @map("employee_name")
  organizationId    String?               @map("organization_id")
  departmentId      String?               @map("department_id")
  departmentName    String?               @map("department_name")
  positionId        String?               @map("position_id")
  positionTitle     String?               @map("position_title")
  compensationId    String?               @map("compensation_id")
  compensation      EmployeeCompensation? @relation(fields: [compensationId], references: [id])
  baseSalary        Decimal               @map("base_salary") @db.Decimal(18, 2)
  /// Derived rates, kept at six places so a minute rate multiplied back does not drift.
  dailyRate         Decimal               @map("daily_rate") @db.Decimal(18, 6)
  minuteRate        Decimal               @map("minute_rate") @db.Decimal(18, 6)
  grossPay          Decimal               @map("gross_pay") @db.Decimal(18, 2)
  totalDeductions   Decimal               @map("total_deductions") @db.Decimal(18, 2)
  netPay            Decimal               @map("net_pay") @db.Decimal(18, 2)
  currencyCode      String                @default("THB") @map("currency_code")
  // the inputs this money was derived from, frozen at calculation
  absentDays        Decimal               @default(0) @map("absent_days") @db.Decimal(8, 2)
  lateMinutes       Int                   @default(0) @map("late_minutes")
  unpaidLeaveUnits  Decimal               @default(0) @map("unpaid_leave_units") @db.Decimal(8, 2)
  approvedOtMinutes Int                   @default(0) @map("approved_ot_minutes")
  proratedDays      Decimal?              @map("prorated_days") @db.Decimal(8, 2)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  items PayrollResultItem[]

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@map("payroll_results")
}

/// A payslip line. The component's code and name are snapshotted: renaming a component never rewrites history.
model PayrollResultItem {
  id                    String        @id @default(cuid())
  payrollResultId       String        @map("payroll_result_id")
  payrollResult         PayrollResult @relation(fields: [payrollResultId], references: [id], onDelete: Cascade)
  componentId           String?       @map("component_id")
  component             PayComponent? @relation(fields: [componentId], references: [id])
  componentCodeSnapshot String        @map("component_code_snapshot")
  componentNameSnapshot String        @map("component_name_snapshot")
  type                  String // EARNING | DEDUCTION
  source                String // BASE | RECURRING | OT | ATTENDANCE | LEAVE | MANUAL | STATUTORY
  quantity              Decimal?      @db.Decimal(18, 4)
  rate                  Decimal?      @db.Decimal(18, 6)
  multiplier            Decimal?      @db.Decimal(8, 4)
  amount                Decimal       @db.Decimal(18, 2)
  description           String?
  /// What produced this line — an overtime request, a leave request, an attendance date, a recurring item.
  referenceType         String?       @map("reference_type")
  referenceId           String?       @map("reference_id")
  /// Manual adjustments survive a recalculation; generated lines are rebuilt.
  isManual              Boolean       @default(false) @map("is_manual")
  createdAt             DateTime      @default(now()) @map("created_at")
  createdByUserId       String?       @map("created_by_user_id")

  @@index([payrollResultId])
  @@index([referenceType, referenceId])
  @@map("payroll_result_items")
}

// ---------------------------------------------------------------------------
// Performance (Task 23)
// ---------------------------------------------------------------------------

/// One appraisal round: a period, optional review windows, a score scale and the bands that name a score.
model PerformanceCycle {
  id                 String        @id @default(cuid())
  code               String        @unique
  name               String
  description        String?
  organizationId     String?       @map("organization_id")
  organization       Organization? @relation(fields: [organizationId], references: [id])
  periodStart        String        @map("period_start") // YYYY-MM-DD
  periodEnd          String        @map("period_end")
  selfReviewStart    String?       @map("self_review_start")
  selfReviewEnd      String?       @map("self_review_end")
  managerReviewStart String?       @map("manager_review_start")
  managerReviewEnd   String?       @map("manager_review_end")
  /// Not every employer asks people to appraise themselves.
  selfReviewRequired Boolean       @default(true) @map("self_review_required")
  /// The score scale is the customer's: nothing assumes 1–5.
  minScore           Decimal       @default(1) @map("min_score") @db.Decimal(6, 2)
  maxScore           Decimal       @default(5) @map("max_score") @db.Decimal(6, 2)
  scoreStep          Decimal       @default(0.1) @map("score_step") @db.Decimal(6, 2)
  status             String        @default("DRAFT") // DRAFT | ACTIVE | REVIEW | CLOSED
  activatedAt        DateTime?     @map("activated_at")
  reviewOpenedAt     DateTime?     @map("review_opened_at")
  closedAt           DateTime?     @map("closed_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  createdByUserId    String?       @map("created_by_user_id")

  ratingBands        PerformanceRatingBand[]
  plans              PerformancePlan[]
  talentReviewCycles TalentReviewCycle[]

  @@index([status])
  @@index([organizationId])
  @@map("performance_cycles")
}

/// What a score is called. Inclusive at both ends, no overlaps, and the whole scale must be covered before a cycle
/// can be activated — a finalized score with no band would have no rating to show.
model PerformanceRatingBand {
  id       String           @id @default(cuid())
  cycleId  String           @map("cycle_id")
  cycle    PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  code     String
  label    String
  minScore Decimal          @map("min_score") @db.Decimal(6, 2)
  maxScore Decimal          @map("max_score") @db.Decimal(6, 2)

  @@unique([cycleId, code])
  @@index([cycleId])
  @@map("performance_rating_bands")
}

/// A reusable KPI definition. What an employee was actually measured on is snapshotted onto their plan, so editing
/// the library never rewrites a finished review.
model PerformanceKpi {
  id              String        @id @default(cuid())
  code            String        @unique
  name            String
  description     String?
  category        String?
  measurementType String        @map("measurement_type") // NUMBER | PERCENTAGE | BOOLEAN | MILESTONE | QUALITATIVE
  unit            String?
  defaultWeight   Decimal?      @map("default_weight") @db.Decimal(6, 2)
  organizationId  String?       @map("organization_id")
  organization    Organization? @relation(fields: [organizationId], references: [id])
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  createdByUserId String?       @map("created_by_user_id")

  planItems PerformancePlanItem[]

  @@index([isActive])
  @@index([category])
  @@map("performance_kpis")
}

/// One employee's plan for one cycle. The organizational snapshot and the reviewer are frozen when the plan is
/// created: a transfer or a change of manager half way through a cycle must not rewrite who was reviewed by whom.
model PerformancePlan {
  id         String           @id @default(cuid())
  cycleId    String           @map("cycle_id")
  cycle      PerformanceCycle @relation(fields: [cycleId], references: [id])
  employeeId String           @map("employee_id")
  employee   Employee         @relation("PerformancePlanEmployee", fields: [employeeId], references: [id])

  // snapshots, taken when the plan is created
  employeeCodeSnapshot String  @map("employee_code_snapshot")
  employeeNameSnapshot String  @map("employee_name_snapshot")
  organizationId       String? @map("organization_id")
  organizationName     String? @map("organization_name")
  departmentId         String? @map("department_id")
  departmentName       String? @map("department_name")
  positionId           String? @map("position_id")
  positionTitle        String? @map("position_title")
  jobId                String? @map("job_id")
  jobTitle             String? @map("job_title")

  /// Who reviews this plan. Frozen at creation; only an explicit reassignment changes it.
  reviewerEmployeeId   String?   @map("reviewer_employee_id")
  reviewerEmployee     Employee? @relation("PerformancePlanReviewer", fields: [reviewerEmployeeId], references: [id])
  reviewerUserId       String?   @map("reviewer_user_id")
  reviewerUser         User?     @relation("PerformancePlanReviewerUser", fields: [reviewerUserId], references: [id])
  reviewerNameSnapshot String?   @map("reviewer_name_snapshot")

  status             String    @default("DRAFT") // DRAFT | ACTIVE | SELF_REVIEW | MANAGER_REVIEW | FINALIZED
  selfSubmittedAt    DateTime? @map("self_submitted_at")
  managerSubmittedAt DateTime? @map("manager_submitted_at")
  finalizedAt        DateTime? @map("finalized_at")

  /// Calculated once, when the manager submits: SUM(managerScore × weight / 100).
  weightedScore       Decimal? @map("weighted_score") @db.Decimal(6, 2)
  ratingCode          String?  @map("rating_code")
  ratingLabelSnapshot String?  @map("rating_label_snapshot")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items PerformancePlanItem[]

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([reviewerUserId])
  @@index([cycleId, status])
  @@map("performance_plans")
}

/// One measured thing on one plan. The KPI's code, name and measurement are snapshotted here.
model PerformancePlanItem {
  id                  String          @id @default(cuid())
  planId              String          @map("plan_id")
  plan                PerformancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  kpiId               String?         @map("kpi_id")
  kpi                 PerformanceKpi? @relation(fields: [kpiId], references: [id])
  kpiCodeSnapshot     String          @map("kpi_code_snapshot")
  kpiNameSnapshot     String          @map("kpi_name_snapshot")
  descriptionSnapshot String?         @map("description_snapshot")
  measurementType     String          @map("measurement_type")

  /// Percentage points. A plan's items must add up to exactly 100 before anybody reviews it.
  weight          Decimal  @db.Decimal(6, 2)
  targetValue     Decimal? @map("target_value") @db.Decimal(18, 2)
  targetText      String?  @map("target_text")
  actualValue     Decimal? @map("actual_value") @db.Decimal(18, 2)
  actualText      String?  @map("actual_text")
  progressPercent Int?     @map("progress_percent")

  /// Review comments are sensitive HR data: they never appear in logs, notifications or audit payloads.
  employeeComment String?  @map("employee_comment")
  managerComment  String?  @map("manager_comment")
  selfScore       Decimal? @map("self_score") @db.Decimal(6, 2)
  managerScore    Decimal? @map("manager_score") @db.Decimal(6, 2)
  /// What the weighted score was actually calculated from, frozen at finalization.
  finalScore      Decimal? @map("final_score") @db.Decimal(6, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([planId])
  @@index([kpiId])
  @@map("performance_plan_items")
}

// ---------------------------------------------------------------------------
// Competency (Task 24)
// ---------------------------------------------------------------------------

/// How competencies are grouped — core, leadership, functional, technical. The names are the customer's.
model CompetencyCategory {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  competencies Competency[]

  @@map("competency_categories")
}

/// A proficiency scale. Nothing assumes 1–5: how many levels there are and what they are called is configuration.
model CompetencyScale {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  levels       CompetencyScaleLevel[]
  competencies Competency[]

  @@map("competency_scales")
}

/// One rung of a scale. The level is the number that gets recorded; the label is what it means.
model CompetencyScaleLevel {
  id          String          @id @default(cuid())
  scaleId     String          @map("scale_id")
  scale       CompetencyScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  level       Int
  label       String
  description String?

  @@unique([scaleId, level])
  @@index([scaleId])
  @@map("competency_scale_levels")
}

/// A competency: something somebody can be more or less good at, measured on one scale.
model Competency {
  id              String             @id @default(cuid())
  code            String             @unique
  name            String
  description     String?
  categoryId      String             @map("category_id")
  category        CompetencyCategory @relation(fields: [categoryId], references: [id])
  scaleId         String             @map("scale_id")
  scale           CompetencyScale    @relation(fields: [scaleId], references: [id])
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  createdByUserId String?            @map("created_by_user_id")

  indicators      CompetencyLevelIndicator[]
  requirements    JobCompetencyRequirement[]
  assessmentItems CompetencyAssessmentItem[]
  trainingNeeds   TrainingNeed[]
  courses         TrainingCourseCompetency[]
  idpItems        IdpItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("competencies")
}

/// What a level looks like in practice, so two reviewers mean the same thing by "level 3". Guidance, not a rule:
/// changing it never rewrites an assessment that has already been made.
model CompetencyLevelIndicator {
  id           String     @id @default(cuid())
  competencyId String     @map("competency_id")
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  level        Int
  description  String

  @@unique([competencyId, level])
  @@index([competencyId])
  @@map("competency_level_indicators")
}

/// What a job asks for. Requirements hang off the **job**, because a position already names one and an employee's
/// position is what connects them to it.
model JobCompetencyRequirement {
  id            String     @id @default(cuid())
  jobId         String     @map("job_id")
  job           Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  competencyId  String     @map("competency_id")
  competency    Competency @relation(fields: [competencyId], references: [id])
  requiredLevel Int        @map("required_level")
  /// A priority, not a percentage — a framework weights what matters and need not add up to 100.
  weight        Decimal?   @db.Decimal(6, 2)
  isMandatory   Boolean    @default(true) @map("is_mandatory")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@unique([jobId, competencyId])
  @@index([jobId])
  @@index([competencyId])
  @@map("job_competency_requirements")
}

/// One assessment round. Stage changes are made by a person; there is no scheduler.
model CompetencyAssessmentCycle {
  id                     String    @id @default(cuid())
  code                   String    @unique
  name                   String
  description            String?
  periodStart            String    @map("period_start") // YYYY-MM-DD
  periodEnd              String    @map("period_end")
  selfAssessmentRequired Boolean   @default(true) @map("self_assessment_required")
  status                 String    @default("DRAFT") // DRAFT | ACTIVE | REVIEW | CLOSED
  activatedAt            DateTime? @map("activated_at")
  reviewOpenedAt         DateTime? @map("review_opened_at")
  closedAt               DateTime? @map("closed_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  createdByUserId        String?   @map("created_by_user_id")

  assessments CompetencyAssessment[]

  @@index([status])
  @@map("competency_assessment_cycles")
}

/// One employee's assessment for one cycle, with the job they held and the reviewer they were given frozen onto it.
model CompetencyAssessment {
  id         String                    @id @default(cuid())
  cycleId    String                    @map("cycle_id")
  cycle      CompetencyAssessmentCycle @relation(fields: [cycleId], references: [id])
  employeeId String                    @map("employee_id")
  employee   Employee                  @relation("CompetencyAssessmentEmployee", fields: [employeeId], references: [id])

  // snapshots, taken when the assessment is created
  employeeCodeSnapshot String  @map("employee_code_snapshot")
  employeeNameSnapshot String  @map("employee_name_snapshot")
  organizationId       String? @map("organization_id")
  organizationName     String? @map("organization_name")
  departmentId         String? @map("department_id")
  departmentName       String? @map("department_name")
  positionId           String? @map("position_id")
  positionTitle        String? @map("position_title")
  jobId                String? @map("job_id")
  jobTitle             String? @map("job_title")

  reviewerEmployeeId   String?   @map("reviewer_employee_id")
  reviewerEmployee     Employee? @relation("CompetencyAssessmentReviewer", fields: [reviewerEmployeeId], references: [id])
  reviewerUserId       String?   @map("reviewer_user_id")
  reviewerUser         User?     @relation("CompetencyAssessmentReviewerUser", fields: [reviewerUserId], references: [id])
  reviewerNameSnapshot String?   @map("reviewer_name_snapshot")

  status             String    @default("DRAFT") // DRAFT | ACTIVE | SELF_REVIEW | MANAGER_REVIEW | FINALIZED
  selfSubmittedAt    DateTime? @map("self_submitted_at")
  managerSubmittedAt DateTime? @map("manager_submitted_at")
  finalizedAt        DateTime? @map("finalized_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items CompetencyAssessmentItem[]

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([reviewerUserId])
  @@index([cycleId, status])
  @@map("competency_assessments")
}

/// One competency on one assessment. The requirement is snapshotted here: raising a job's requirement next month
/// must not retroactively turn a closed assessment into a gap.
model CompetencyAssessmentItem {
  id           String               @id @default(cuid())
  assessmentId String               @map("assessment_id")
  assessment   CompetencyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  competencyId String?              @map("competency_id")
  competency   Competency?          @relation(fields: [competencyId], references: [id])

  competencyCodeSnapshot String  @map("competency_code_snapshot")
  competencyNameSnapshot String  @map("competency_name_snapshot")
  categorySnapshot       String  @map("category_snapshot")
  scaleIdSnapshot        String? @map("scale_id_snapshot")
  scaleNameSnapshot      String? @map("scale_name_snapshot")
  /// The scale's levels and the competency's indicators as they read at assessment time, so an old assessment still
  /// explains itself after the library moves on. JSON, because it is a frozen copy and never queried.
  levelLabelsSnapshot    Json?   @map("level_labels_snapshot")
  indicatorsSnapshot     Json?   @map("indicators_snapshot")

  requiredLevelSnapshot Int      @map("required_level_snapshot")
  weightSnapshot        Decimal? @map("weight_snapshot") @db.Decimal(6, 2)
  isMandatorySnapshot   Boolean  @default(true) @map("is_mandatory_snapshot")

  selfLevel    Int? @map("self_level")
  managerLevel Int? @map("manager_level")
  /// What the gap is measured against. In this release it is the manager's level, frozen at finalization.
  finalLevel   Int? @map("final_level")

  /// Assessment comments are sensitive HR text: they live here and never in a log, notification or report.
  selfComment    String? @map("self_comment")
  managerComment String? @map("manager_comment")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([assessmentId])
  @@index([competencyId])
  @@map("competency_assessment_items")
}

// ---------------------------------------------------------------------------
// Training and development (Task 25)
// ---------------------------------------------------------------------------

/// Something somebody needs to develop. A gap-based need freezes the numbers it came from: a job's requirement can
/// move next month, and a need that quietly re-described itself could never explain why anybody was sent on a course.
model TrainingNeed {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  source      String // COMPETENCY_GAP | MANUAL
  title       String
  description String?

  competencyId           String?     @map("competency_id")
  competency             Competency? @relation(fields: [competencyId], references: [id])
  competencyCodeSnapshot String?     @map("competency_code_snapshot")
  competencyNameSnapshot String?     @map("competency_name_snapshot")

  /// The gap exactly as it stood when the need was raised.
  currentLevelSnapshot  Int? @map("current_level_snapshot")
  requiredLevelSnapshot Int? @map("required_level_snapshot")
  gapSnapshot           Int? @map("gap_snapshot")

  employeeCodeSnapshot   String  @map("employee_code_snapshot")
  employeeNameSnapshot   String  @map("employee_name_snapshot")
  jobId                  String? @map("job_id")
  jobTitleSnapshot       String? @map("job_title_snapshot")
  departmentId           String? @map("department_id")
  departmentNameSnapshot String? @map("department_name_snapshot")

  sourceAssessmentDate DateTime? @map("source_assessment_date")
  priority             String    @default("NORMAL") // NORMAL | HIGH
  status               String    @default("OPEN") // OPEN | PLANNED | IN_PROGRESS | FULFILLED | CANCELLED
  fulfilledAt          DateTime? @map("fulfilled_at")

  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  enrollments TrainingEnrollment[]
  idpItems    IdpItem[]

  @@index([employeeId, status])
  @@index([competencyId])
  @@index([departmentId])
  @@map("training_needs")
}

/// A course in the catalogue. No content is hosted here: this is the record that a course exists, what it develops
/// and how long it takes.
model TrainingCourse {
  id              String   @id @default(cuid())
  code            String   @unique
  title           String
  description     String?
  category        String?
  deliveryMethod  String   @map("delivery_method") // CLASSROOM | VIRTUAL | SELF_STUDY | BLENDED | OTHER
  durationMinutes Int?     @map("duration_minutes")
  providerName    String?  @map("provider_name")
  providerType    String   @default("INTERNAL") @map("provider_type") // INTERNAL | EXTERNAL
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdByUserId String?  @map("created_by_user_id")

  competencies TrainingCourseCompetency[]
  sessions     TrainingSession[]
  idpItems     IdpItem[]

  @@index([isActive])
  @@map("training_courses")
}

/// "This course is relevant to developing this competency." It is **not** a promise that finishing it puts anybody at
/// `targetLevel` — only a competency assessment decides a level.
model TrainingCourseCompetency {
  id           String         @id @default(cuid())
  courseId     String         @map("course_id")
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competencyId String         @map("competency_id")
  competency   Competency     @relation(fields: [competencyId], references: [id])
  targetLevel  Int?           @map("target_level")

  @@unique([courseId, competencyId])
  @@index([competencyId])
  @@map("training_course_competencies")
}

/// One scheduled run of a course. Instants are UTC; `timezone` is how they are read back.
model TrainingSession {
  id                  String         @id @default(cuid())
  courseId            String         @map("course_id")
  course              TrainingCourse @relation(fields: [courseId], references: [id])
  courseCodeSnapshot  String         @map("course_code_snapshot")
  courseTitleSnapshot String         @map("course_title_snapshot")
  organizationId      String?        @map("organization_id")
  organization        Organization?  @relation(fields: [organizationId], references: [id])

  startAt  DateTime @map("start_at")
  endAt    DateTime @map("end_at")
  /// IANA zone, e.g. Asia/Bangkok. Never a fixed offset.
  timezone String

  location       String?
  meetingUrl     String? @map("meeting_url")
  capacity       Int?
  instructorName String? @map("instructor_name")

  status      String    @default("DRAFT") // DRAFT | OPEN | IN_PROGRESS | COMPLETED | CANCELLED
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdByUserId String?  @map("created_by_user_id")

  enrollments TrainingEnrollment[]

  @@index([courseId])
  @@index([status, startAt])
  @@map("training_sessions")
}

/// One person on one session. A session being complete says nothing about any individual: one attendee may have
/// completed it, another failed it, and a third never turned up.
model TrainingEnrollment {
  id         String          @id @default(cuid())
  sessionId  String          @map("session_id")
  session    TrainingSession @relation(fields: [sessionId], references: [id])
  employeeId String          @map("employee_id")
  employee   Employee        @relation(fields: [employeeId], references: [id])

  employeeCodeSnapshot   String  @map("employee_code_snapshot")
  employeeNameSnapshot   String  @map("employee_name_snapshot")
  departmentNameSnapshot String? @map("department_name_snapshot")

  /// Why this person is here, so a training record explains itself later.
  source         String        @default("MANUAL") // MANUAL | TNA | IDP
  trainingNeedId String?       @map("training_need_id")
  trainingNeed   TrainingNeed? @relation(fields: [trainingNeedId], references: [id])
  idpItemId      String?       @map("idp_item_id")
  idpItem        IdpItem?      @relation(fields: [idpItemId], references: [id])

  status       String    @default("ENROLLED") // ENROLLED | ATTENDED | COMPLETED | FAILED | NO_SHOW | CANCELLED
  enrolledAt   DateTime  @default(now()) @map("enrolled_at")
  completionAt DateTime? @map("completion_at")
  score        Decimal?  @db.Decimal(6, 2)
  resultNote   String?   @map("result_note")

  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, employeeId])
  @@index([employeeId, status])
  @@index([trainingNeedId])
  @@map("training_enrollments")
}

/// An individual development plan: what somebody is going to do about their development this period.
model IndividualDevelopmentPlan {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  employee   Employee @relation("IdpEmployee", fields: [employeeId], references: [id])

  employeeCodeSnapshot   String  @map("employee_code_snapshot")
  employeeNameSnapshot   String  @map("employee_name_snapshot")
  departmentNameSnapshot String? @map("department_name_snapshot")

  title       String
  periodStart String @map("period_start") // YYYY-MM-DD
  periodEnd   String @map("period_end")

  managerEmployeeId   String?   @map("manager_employee_id")
  managerEmployee     Employee? @relation("IdpManager", fields: [managerEmployeeId], references: [id])
  managerUserId       String?   @map("manager_user_id")
  managerUser         User?     @relation("IdpManagerUser", fields: [managerUserId], references: [id])
  managerNameSnapshot String?   @map("manager_name_snapshot")

  status      String    @default("DRAFT") // DRAFT | ACTIVE | COMPLETED | CANCELLED
  activatedAt DateTime? @map("activated_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  items IdpItem[]

  @@index([employeeId, status])
  @@map("individual_development_plans")
}

/// One thing somebody is going to do. Training is one development type of several — that is the point of a plan.
model IdpItem {
  id    String                    @id @default(cuid())
  idpId String                    @map("idp_id")
  idp   IndividualDevelopmentPlan @relation(fields: [idpId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  developmentType String  @map("development_type") // TRAINING | OJT | COACHING | MENTORING | SELF_STUDY | PROJECT | OTHER

  trainingNeedId         String?       @map("training_need_id")
  trainingNeed           TrainingNeed? @relation(fields: [trainingNeedId], references: [id])
  competencyId           String?       @map("competency_id")
  competency             Competency?   @relation(fields: [competencyId], references: [id])
  /// Frozen so a renamed competency never makes an old plan unreadable.
  competencyCodeSnapshot String?       @map("competency_code_snapshot")
  competencyNameSnapshot String?       @map("competency_name_snapshot")

  linkedCourseId  String?         @map("linked_course_id")
  linkedCourse    TrainingCourse? @relation(fields: [linkedCourseId], references: [id])
  linkedSessionId String?         @map("linked_session_id")

  targetDate      String? @map("target_date") // YYYY-MM-DD
  status          String  @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  progressPercent Int     @default(0) @map("progress_percent")

  /// Development comments are HR data. `hrComment` is HR's alone; the others follow the visibility documented in
  /// docs/training-development.md. None of them ever reaches a log, a notification or an audit payload.
  employeeComment String? @map("employee_comment")
  managerComment  String? @map("manager_comment")
  hrComment       String? @map("hr_comment")

  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  enrollments TrainingEnrollment[]

  @@index([idpId])
  @@index([trainingNeedId])
  @@map("idp_items")
}

// ---------------------------------------------------------------------------
// Employee relations (Task 26)
// ---------------------------------------------------------------------------

/// What can be done. Configured by the customer: the codes are theirs, the order is for display, and nothing here is
/// a ladder the system climbs on its own.
model DisciplinaryActionType {
  id                      String   @id @default(cuid())
  code                    String   @unique
  name                    String
  description             String?
  severityOrder           Int      @default(0) @map("severity_order")
  requiresWarningLetter   Boolean  @default(true) @map("requires_warning_letter")
  requiresAcknowledgement Boolean  @default(true) @map("requires_acknowledgement")
  defaultValidityDays     Int?     @map("default_validity_days")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  actions DisciplinaryAction[]

  @@map("disciplinary_action_types")
}

model DisciplinaryCaseCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  cases EmployeeRelationCase[]

  @@map("disciplinary_case_categories")
}

/// Operational defaults per organization: which approval workflow, how long an employee has to acknowledge. Not a
/// rule engine, and it encodes no penalty.
model DisciplinaryPolicy {
  id                            String       @id @default(cuid())
  organizationId                String       @map("organization_id")
  organization                  Organization @relation(fields: [organizationId], references: [id])
  name                          String
  workflowDefinitionCode        String       @map("workflow_definition_code")
  defaultAcknowledgementDueDays Int?         @map("default_acknowledgement_due_days")
  effectiveFrom                 String       @map("effective_from")
  effectiveTo                   String?      @map("effective_to")
  isActive                      Boolean      @default(true) @map("is_active")
  createdAt                     DateTime     @default(now()) @map("created_at")
  updatedAt                     DateTime     @updatedAt @map("updated_at")

  @@index([organizationId, isActive])
  @@map("disciplinary_policies")
}

/// A letter template with allow-listed placeholders only. No expressions, nothing executable.
model WarningLetterTemplate {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  subjectTemplate String   @map("subject_template")
  bodyTemplate    String   @map("body_template")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("warning_letter_templates")
}

/// One counter row per year, taken under a row lock, so two cases opened at the same instant get different numbers.
model EmployeeRelationCaseSequence {
  year Int @id
  next Int @default(1)

  @@map("employee_relation_case_sequences")
}

/// A case: what was reported about whom, and what was decided. The organizational snapshot is frozen at creation —
/// a later transfer does not move the record.
model EmployeeRelationCase {
  id         String   @id @default(cuid())
  caseNumber String   @unique @map("case_number")
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  employeeCodeSnapshot String  @map("employee_code_snapshot")
  employeeNameSnapshot String  @map("employee_name_snapshot")
  organizationId       String? @map("organization_id")
  organizationName     String? @map("organization_name")
  departmentId         String? @map("department_id")
  departmentName       String? @map("department_name")
  positionId           String? @map("position_id")
  positionTitle        String? @map("position_title")
  jobId                String? @map("job_id")
  jobTitle             String? @map("job_title")

  incidentDate String   @map("incident_date") // YYYY-MM-DD
  reportedAt   DateTime @default(now()) @map("reported_at")

  categoryId           String?                   @map("category_id")
  category             DisciplinaryCaseCategory? @relation(fields: [categoryId], references: [id])
  categoryNameSnapshot String?                   @map("category_name_snapshot")

  title         String
  /// The narrative. It lives here and in the issued letter, and nowhere else — never in a log, an audit payload or a notification.
  description   String
  /// HR's own investigation notes: `employee_relations.manage` only.
  internalNotes String? @map("internal_notes")

  status      String    @default("DRAFT") // DRAFT | UNDER_REVIEW | PENDING_APPROVAL | ACTION_ISSUED | CLOSED | CANCELLED
  closedAt    DateTime? @map("closed_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdByUserId  String   @map("created_by_user_id")
  assignedToUserId String?  @map("assigned_to_user_id")
  assignedTo       User?    @relation("ErCaseAssignee", fields: [assignedToUserId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  actions DisciplinaryAction[]

  @@index([employeeId, status])
  @@index([departmentId])
  @@index([incidentDate])
  @@map("employee_relation_cases")
}

/// A proposed, approved or issued action on a case. Reaches ISSUED through a final workflow approval and no other way.
model DisciplinaryAction {
  id         String               @id @default(cuid())
  caseId     String               @map("case_id")
  case       EmployeeRelationCase @relation(fields: [caseId], references: [id])
  employeeId String               @map("employee_id")
  employee   Employee             @relation(fields: [employeeId], references: [id])

  actionTypeId            String                 @map("action_type_id")
  actionType              DisciplinaryActionType @relation(fields: [actionTypeId], references: [id])
  actionTypeCodeSnapshot  String                 @map("action_type_code_snapshot")
  actionTypeNameSnapshot  String                 @map("action_type_name_snapshot")
  requiresWarningLetter   Boolean                @default(true) @map("requires_warning_letter")
  requiresAcknowledgement Boolean                @default(true) @map("requires_acknowledgement")

  reason        String
  effectiveDate String? @map("effective_date")
  validityDays  Int?    @map("validity_days")
  issuedDate    String? @map("issued_date")
  /// Frozen at issue from the validity that was submitted. Nothing recomputes it.
  validUntil    String? @map("valid_until")

  status             String  @default("DRAFT") // DRAFT | PENDING_APPROVAL | ISSUED | ACKNOWLEDGED | REJECTED | CANCELLED
  workflowInstanceId String? @unique @map("workflow_instance_id")

  letterTemplateId String? @map("letter_template_id")
  letterSubject    String? @map("letter_subject")
  letterBody       String? @map("letter_body")

  acknowledgementDueDate String?   @map("acknowledgement_due_date")
  acknowledgedAt         DateTime? @map("acknowledged_at")
  declinedAt             DateTime? @map("declined_at")
  declineNote            String?   @map("decline_note")

  submittedAt     DateTime? @map("submitted_at")
  approvedAt      DateTime? @map("approved_at")
  issuedAt        DateTime? @map("issued_at")
  issuedByUserId  String?   @map("issued_by_user_id")
  rejectedAt      DateTime? @map("rejected_at")
  cancelledAt     DateTime? @map("cancelled_at")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  letter          WarningLetter?
  acknowledgement DisciplinaryAcknowledgement?

  @@index([caseId])
  @@index([employeeId, status])
  @@index([status, validUntil])
  @@map("disciplinary_actions")
}

/// The letter as issued. Immutable: every field is a snapshot, and no endpoint updates this table.
model WarningLetter {
  id                          String             @id @default(cuid())
  disciplinaryActionId        String             @unique @map("disciplinary_action_id")
  action                      DisciplinaryAction @relation(fields: [disciplinaryActionId], references: [id])
  letterNumber                String             @unique @map("letter_number")
  subject                     String
  employeeNameSnapshot        String             @map("employee_name_snapshot")
  employeeCodeSnapshot        String             @map("employee_code_snapshot")
  positionSnapshot            String?            @map("position_snapshot")
  departmentSnapshot          String?            @map("department_snapshot")
  organizationSnapshot        String?            @map("organization_snapshot")
  incidentDateSnapshot        String             @map("incident_date_snapshot")
  actionNameSnapshot          String             @map("action_name_snapshot")
  bodySnapshot                String             @map("body_snapshot")
  validUntilSnapshot          String?            @map("valid_until_snapshot")
  acknowledgementTextSnapshot String             @map("acknowledgement_text_snapshot")
  issuedAt                    DateTime           @map("issued_at")
  createdAt                   DateTime           @default(now()) @map("created_at")

  @@map("warning_letters")
}

/// Receipt, and only receipt. The statement the employee agreed to is frozen with it.
model DisciplinaryAcknowledgement {
  id                          String             @id @default(cuid())
  actionId                    String             @unique @map("action_id")
  action                      DisciplinaryAction @relation(fields: [actionId], references: [id])
  employeeId                  String             @map("employee_id")
  employee                    Employee           @relation(fields: [employeeId], references: [id])
  userId                      String             @map("user_id")
  user                        User               @relation(fields: [userId], references: [id])
  acknowledgedAt              DateTime           @map("acknowledged_at")
  acknowledgementTextSnapshot String             @map("acknowledgement_text_snapshot")
  ipAddress                   String?            @map("ip_address")
  userAgent                   String?            @map("user_agent")

  @@unique([actionId, employeeId])
  @@map("disciplinary_acknowledgements")
}

// ---------------------------------------------------------------------------
// Recruitment (Task 27)
// ---------------------------------------------------------------------------

/// Which workflow approves a requisition and which approves an offer, per organization.
model RecruitmentPolicy {
  id                      String       @id @default(cuid())
  organizationId          String       @unique @map("organization_id")
  organization            Organization @relation(fields: [organizationId], references: [id])
  requisitionWorkflowCode String       @map("requisition_workflow_code")
  offerWorkflowCode       String       @map("offer_workflow_code")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  @@map("recruitment_policies")
}

/// One counter per document kind and year, taken under a row lock, so two records created at once never collide.
model RecruitmentSequence {
  kind String
  year Int
  next Int    @default(1)

  @@id([kind, year])
  @@map("recruitment_sequences")
}

/// A request for headcount, approved through the shared workflow. Masters are referenced, and what the approver saw
/// is snapshotted at submit.
model RecruitmentRequisition {
  id                String       @id @default(cuid())
  requisitionNumber String       @unique @map("requisition_number")
  organizationId    String       @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])
  departmentId      String?      @map("department_id")
  jobId             String       @map("job_id")
  job               Job          @relation(fields: [jobId], references: [id])
  positionId        String?      @map("position_id")

  hiringManagerEmployeeId String?   @map("hiring_manager_employee_id")
  hiringManagerEmployee   Employee? @relation("RequisitionHiringManager", fields: [hiringManagerEmployeeId], references: [id])
  hiringManagerUserId     String?   @map("hiring_manager_user_id")

  requestedOpenings Int     @map("requested_openings")
  employmentType    String? @map("employment_type")
  reason            String // NEW_HEADCOUNT | REPLACEMENT | TEMPORARY | OTHER
  desiredStartDate  String? @map("desired_start_date")
  justification     String?

  // snapshots, taken at submit
  organizationNameSnapshot  String? @map("organization_name_snapshot")
  departmentNameSnapshot    String? @map("department_name_snapshot")
  jobTitleSnapshot          String? @map("job_title_snapshot")
  positionTitleSnapshot     String? @map("position_title_snapshot")
  hiringManagerNameSnapshot String? @map("hiring_manager_name_snapshot")

  status             String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | CANCELLED | CLOSED
  workflowInstanceId String?   @unique @map("workflow_instance_id")
  submittedAt        DateTime? @map("submitted_at")
  approvedAt         DateTime? @map("approved_at")
  rejectedAt         DateTime? @map("rejected_at")
  cancelledAt        DateTime? @map("cancelled_at")
  closedAt           DateTime? @map("closed_at")
  createdByUserId    String    @map("created_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  openings RecruitmentOpening[]

  @@index([status])
  @@index([hiringManagerUserId])
  @@index([organizationId])
  @@map("recruitment_requisitions")
}

/// A vacancy that takes applications inside the ATS. OPEN publishes nothing anywhere.
model RecruitmentOpening {
  id            String                 @id @default(cuid())
  openingNumber String                 @unique @map("opening_number")
  requisitionId String                 @map("requisition_id")
  requisition   RecruitmentRequisition @relation(fields: [requisitionId], references: [id])
  jobId         String                 @map("job_id")
  job           Job                    @relation(fields: [jobId], references: [id])
  positionId    String?                @map("position_id")

  titleSnapshot             String  @map("title_snapshot")
  departmentNameSnapshot    String? @map("department_name_snapshot")
  organizationNameSnapshot  String? @map("organization_name_snapshot")
  hiringManagerUserId       String? @map("hiring_manager_user_id")
  hiringManagerEmployeeId   String? @map("hiring_manager_employee_id")
  hiringManagerNameSnapshot String? @map("hiring_manager_name_snapshot")

  description      String?
  requirementsText String?   @map("requirements_text")
  openingsCount    Int       @map("openings_count")
  openedAt         DateTime? @map("opened_at")
  targetCloseDate  String?   @map("target_close_date")
  status           String    @default("DRAFT") // DRAFT | OPEN | ON_HOLD | CLOSED | CANCELLED
  closedAt         DateTime? @map("closed_at")
  createdByUserId  String    @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  applications RecruitmentApplication[]

  @@index([status])
  @@index([requisitionId])
  @@index([hiringManagerUserId])
  @@map("recruitment_openings")
}

/// A person who has applied, or been approached. The minimum a recruiter needs and nothing protected.
model RecruitmentCandidate {
  id              String   @id @default(cuid())
  candidateNumber String   @unique @map("candidate_number")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  email           String?
  /// Lower-cased and trimmed, for exact duplicate detection. Nothing fuzzy.
  emailNormalized String?  @map("email_normalized")
  phone           String?
  phoneNormalized String?  @map("phone_normalized")
  currentCompany  String?  @map("current_company")
  currentTitle    String?  @map("current_title")
  locationText    String?  @map("location_text")
  source          String   @default("MANUAL")
  sourceDetail    String?  @map("source_detail")
  summary         String?
  status          String   @default("ACTIVE") // ACTIVE | HIRED | ARCHIVED
  hiredEmployeeId String?  @unique @map("hired_employee_id")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  applications RecruitmentApplication[]

  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([status])
  @@map("recruitment_candidates")
}

/// One candidate against one opening. The stage is where they are; the history says who moved them and when.
model RecruitmentApplication {
  id                     String               @id @default(cuid())
  applicationNumber      String               @unique @map("application_number")
  candidateId            String               @map("candidate_id")
  candidate              RecruitmentCandidate @relation(fields: [candidateId], references: [id])
  openingId              String               @map("opening_id")
  opening                RecruitmentOpening   @relation(fields: [openingId], references: [id])
  appliedAt              String               @map("applied_at") // YYYY-MM-DD
  stage                  String               @default("APPLIED")
  recruiterUserId        String?              @map("recruiter_user_id")
  hiringManagerUserId    String?              @map("hiring_manager_user_id")
  sourceSnapshot         String               @map("source_snapshot")
  departmentNameSnapshot String?              @map("department_name_snapshot")
  jobTitleSnapshot       String               @map("job_title_snapshot")

  rejectionReasonCode String?   @map("rejection_reason_code")
  rejectionNote       String?   @map("rejection_note")
  rejectedAt          DateTime? @map("rejected_at")
  withdrawnNote       String?   @map("withdrawn_note")
  withdrawnAt         DateTime? @map("withdrawn_at")
  hiredEmployeeId     String?   @unique @map("hired_employee_id")
  hiredAt             DateTime? @map("hired_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stageHistory RecruitmentApplicationStageHistory[]
  interviews   RecruitmentInterview[]
  offers       RecruitmentOffer[]

  @@unique([candidateId, openingId])
  @@index([openingId, stage])
  @@index([candidateId])
  @@index([hiringManagerUserId])
  @@map("recruitment_applications")
}

/// Append-only. Never edited, never deleted: the answer to "who moved this candidate, and when".
model RecruitmentApplicationStageHistory {
  id              String                 @id @default(cuid())
  applicationId   String                 @map("application_id")
  application     RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage       String?                @map("from_stage")
  toStage         String                 @map("to_stage")
  changedByUserId String                 @map("changed_by_user_id")
  changedAt       DateTime               @default(now()) @map("changed_at")
  reason          String?

  @@index([applicationId, changedAt])
  @@map("recruitment_application_stage_history")
}

/// A scheduled conversation. UTC instants, an IANA zone, and no calendar invite goes anywhere.
model RecruitmentInterview {
  id              String                 @id @default(cuid())
  applicationId   String                 @map("application_id")
  application     RecruitmentApplication @relation(fields: [applicationId], references: [id])
  roundNumber     Int?                   @map("round_number")
  title           String
  scheduledStart  DateTime               @map("scheduled_start")
  scheduledEnd    DateTime               @map("scheduled_end")
  timezone        String
  location        String?
  meetingUrl      String?                @map("meeting_url")
  status          String                 @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  completedAt     DateTime?              @map("completed_at")
  cancelledAt     DateTime?              @map("cancelled_at")
  createdByUserId String                 @map("created_by_user_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  interviewers RecruitmentInterviewer[]
  feedback     RecruitmentInterviewFeedback[]

  @@index([applicationId])
  @@index([scheduledStart])
  @@map("recruitment_interviews")
}

/// Being on this table is what gives somebody purpose-specific access to one interview and its application.
model RecruitmentInterviewer {
  id          String               @id @default(cuid())
  interviewId String               @map("interview_id")
  interview   RecruitmentInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  employeeId  String?              @map("employee_id")
  employee    Employee?            @relation(fields: [employeeId], references: [id])
  userId      String               @map("user_id")
  user        User                 @relation(fields: [userId], references: [id])
  roleLabel   String?              @map("role_label")

  @@unique([interviewId, userId])
  @@index([userId])
  @@map("recruitment_interviewers")
}

/// One interviewer's view. It informs a person; nothing adds these up into a ranking.
model RecruitmentInterviewFeedback {
  id                String               @id @default(cuid())
  interviewId       String               @map("interview_id")
  interview         RecruitmentInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerUserId String               @map("interviewer_user_id")
  interviewer       User                 @relation(fields: [interviewerUserId], references: [id])
  recommendation    String // PROCEED | HOLD | DO_NOT_PROCEED
  overallScore      Int?                 @map("overall_score")
  strengths         String?
  concerns          String?
  comments          String?
  submittedAt       DateTime             @default(now()) @map("submitted_at")

  @@unique([interviewId, interviewerUserId])
  @@map("recruitment_interview_feedback")
}

/// A proposal to a candidate, approved through the shared workflow. The salary is a recruitment figure, not a
/// payroll record: payroll learns nothing from this table.
model RecruitmentOffer {
  id                      String                 @id @default(cuid())
  offerNumber             String                 @unique @map("offer_number")
  applicationId           String                 @map("application_id")
  application             RecruitmentApplication @relation(fields: [applicationId], references: [id])
  status                  String                 @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | SENT | ACCEPTED | DECLINED | WITHDRAWN
  proposedStartDate       String                 @map("proposed_start_date")
  employmentTypeSnapshot  String?                @map("employment_type_snapshot")
  positionId              String?                @map("position_id")
  positionTitleSnapshot   String?                @map("position_title_snapshot")
  baseSalaryProposal      Decimal?               @map("base_salary_proposal") @db.Decimal(18, 2)
  currencyCode            String                 @default("THB") @map("currency_code")
  otherTermsText          String?                @map("other_terms_text")
  workflowInstanceId      String?                @unique @map("workflow_instance_id")
  createdByUserId         String                 @map("created_by_user_id")
  submittedAt             DateTime?              @map("submitted_at")
  approvedAt              DateTime?              @map("approved_at")
  rejectedAt              DateTime?              @map("rejected_at")
  sentAt                  DateTime?              @map("sent_at")
  acceptedAt              DateTime?              @map("accepted_at")
  declinedAt              DateTime?              @map("declined_at")
  withdrawnAt             DateTime?              @map("withdrawn_at")
  outcomeRecordedByUserId String?                @map("outcome_recorded_by_user_id")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  @@index([applicationId])
  @@index([status])
  @@map("recruitment_offers")
}

// ---------------------------------------------------------------------------
// Career, talent and succession (Task 28)
// ---------------------------------------------------------------------------

/// A named set of job-to-job transitions the organization considers possible. Possible — not promised.
model CareerPath {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  description    String?
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  steps CareerPathStep[]

  @@map("career_paths")
}

/// One edge of the career graph: from one job to another. Requirements come from the target job's competency
/// profile (Task 24); nothing about a requirement is stored here.
model CareerPathStep {
  id          String     @id @default(cuid())
  pathId      String     @map("path_id")
  path        CareerPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  fromJobId   String     @map("from_job_id")
  fromJob     Job        @relation("CareerStepFrom", fields: [fromJobId], references: [id])
  toJobId     String     @map("to_job_id")
  toJob       Job        @relation("CareerStepTo", fields: [toJobId], references: [id])
  stepOrder   Int?       @map("step_order")
  description String?

  @@unique([pathId, fromJobId, toJobId])
  @@index([fromJobId])
  @@index([toJobId])
  @@map("career_path_steps")
}

/// One talent review round. The performance input is a finalized performance cycle; how its ratings map onto the
/// three performance buckets is this cycle's configuration, never a constant in the code.
model TalentReviewCycle {
  id                 String            @id @default(cuid())
  code               String            @unique
  name               String
  periodStart        String            @map("period_start")
  periodEnd          String            @map("period_end")
  organizationId     String?           @map("organization_id")
  organization       Organization?     @relation(fields: [organizationId], references: [id])
  performanceCycleId String?           @map("performance_cycle_id")
  performanceCycle   PerformanceCycle? @relation(fields: [performanceCycleId], references: [id])
  /// [{ code: LOW|MEDIUM|HIGH, label, description }] — the organization's own words for potential.
  potentialLevels    Json              @map("potential_levels")
  status             String            @default("DRAFT") // DRAFT | ACTIVE | REVIEW | CLOSED
  activatedAt        DateTime?         @map("activated_at")
  closedAt           DateTime?         @map("closed_at")
  createdByUserId    String?           @map("created_by_user_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  bucketRules TalentPerformanceBucketRule[]
  reviews     TalentReview[]

  @@index([status])
  @@map("talent_review_cycles")
}

/// ratingCode → LOW | MEDIUM | HIGH, one rule per rating band of the linked performance cycle.
model TalentPerformanceBucketRule {
  id         String            @id @default(cuid())
  cycleId    String            @map("cycle_id")
  cycle      TalentReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  ratingCode String            @map("rating_code")
  bucket     String

  @@unique([cycleId, ratingCode])
  @@map("talent_performance_bucket_rules")
}

/// One employee in one talent cycle. Everything about where they were and what their performance said is
/// snapshotted; the potential level is a named reviewer's judgment, written once.
model TalentReview {
  id         String            @id @default(cuid())
  cycleId    String            @map("cycle_id")
  cycle      TalentReviewCycle @relation(fields: [cycleId], references: [id])
  employeeId String            @map("employee_id")
  employee   Employee          @relation("TalentReviewEmployee", fields: [employeeId], references: [id])

  employeeCodeSnapshot     String  @map("employee_code_snapshot")
  employeeNameSnapshot     String  @map("employee_name_snapshot")
  organizationIdSnapshot   String? @map("organization_id_snapshot")
  organizationNameSnapshot String? @map("organization_name_snapshot")
  departmentIdSnapshot     String? @map("department_id_snapshot")
  departmentNameSnapshot   String? @map("department_name_snapshot")
  jobIdSnapshot            String? @map("job_id_snapshot")
  jobTitleSnapshot         String? @map("job_title_snapshot")
  positionIdSnapshot       String? @map("position_id_snapshot")
  positionTitleSnapshot    String? @map("position_title_snapshot")

  performancePlanId              String?  @map("performance_plan_id")
  performanceCycleNameSnapshot   String?  @map("performance_cycle_name_snapshot")
  performanceScoreSnapshot       Decimal? @map("performance_score_snapshot") @db.Decimal(6, 2)
  performanceRatingCodeSnapshot  String?  @map("performance_rating_code_snapshot")
  performanceRatingLabelSnapshot String?  @map("performance_rating_label_snapshot")
  performanceBucket              String?  @map("performance_bucket")

  reviewerEmployeeId   String?   @map("reviewer_employee_id")
  reviewerEmployee     Employee? @relation("TalentReviewReviewer", fields: [reviewerEmployeeId], references: [id])
  reviewerUserId       String?   @map("reviewer_user_id")
  reviewerNameSnapshot String?   @map("reviewer_name_snapshot")

  potentialLevel   String? @map("potential_level")
  potentialComment String? @map("potential_comment")
  potentialBucket  String? @map("potential_bucket")
  nineBoxCell      String? @map("nine_box_cell")

  status      String    @default("ASSIGNED") // ASSIGNED | SUBMITTED | FINALIZED
  submittedAt DateTime? @map("submitted_at")
  finalizedAt DateTime? @map("finalized_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  poolMemberships TalentPoolMember[]

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([reviewerUserId])
  @@index([cycleId, nineBoxCell])
  @@map("talent_reviews")
}

/// A named group of people the organization is watching or developing. Members are added by hand, never by a cell.
model TalentPool {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  description    String?
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  members TalentPoolMember[]

  @@map("talent_pools")
}

/// Membership with history: removal marks the row, it never deletes it.
model TalentPoolMember {
  id                   String        @id @default(cuid())
  poolId               String        @map("pool_id")
  pool                 TalentPool    @relation(fields: [poolId], references: [id])
  employeeId           String        @map("employee_id")
  employee             Employee      @relation(fields: [employeeId], references: [id])
  addedAt              DateTime      @default(now()) @map("added_at")
  addedByUserId        String        @map("added_by_user_id")
  reason               String?
  sourceTalentReviewId String?       @map("source_talent_review_id")
  sourceTalentReview   TalentReview? @relation(fields: [sourceTalentReviewId], references: [id])
  status               String        @default("ACTIVE") // ACTIVE | REMOVED
  removedAt            DateTime?     @map("removed_at")
  removedByUserId      String?       @map("removed_by_user_id")
  removalReason        String?       @map("removal_reason")

  @@index([poolId, status])
  @@index([employeeId])
  @@map("talent_pool_members")
}

/// Who could take over a position. Bound to the position (the real seat), with its job, department and organization
/// frozen as they were when the plan was made.
model SuccessionPlan {
  id                       String    @id @default(cuid())
  positionId               String    @map("position_id")
  position                 Position  @relation(fields: [positionId], references: [id])
  organizationIdSnapshot   String?   @map("organization_id_snapshot")
  organizationNameSnapshot String?   @map("organization_name_snapshot")
  departmentIdSnapshot     String?   @map("department_id_snapshot")
  departmentNameSnapshot   String?   @map("department_name_snapshot")
  jobIdSnapshot            String?   @map("job_id_snapshot")
  jobTitleSnapshot         String?   @map("job_title_snapshot")
  positionTitleSnapshot    String    @map("position_title_snapshot")
  /// Set by a person. Never inferred from salary, headcount or performance.
  criticality              String    @default("NORMAL") // NORMAL | IMPORTANT | CRITICAL
  notes                    String?
  status                   String    @default("DRAFT") // DRAFT | ACTIVE | CLOSED
  closedAt                 DateTime? @map("closed_at")
  createdByUserId          String    @map("created_by_user_id")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  candidates   SuccessionCandidate[]
  department   Department?           @relation(fields: [departmentId], references: [id])
  departmentId String?

  @@index([positionId, status])
  @@index([departmentIdSnapshot])
  @@map("succession_plans")
}

/// A nomination with the nominator's name on it, the readiness they recorded, and the candidate's job as it was.
model SuccessionCandidate {
  id                     String         @id @default(cuid())
  planId                 String         @map("plan_id")
  plan                   SuccessionPlan @relation(fields: [planId], references: [id])
  employeeId             String         @map("employee_id")
  employee               Employee       @relation(fields: [employeeId], references: [id])
  jobTitleSnapshot       String?        @map("job_title_snapshot")
  departmentNameSnapshot String?        @map("department_name_snapshot")
  positionTitleSnapshot  String?        @map("position_title_snapshot")
  readiness              String // READY_NOW | READY_SOON | DEVELOPING
  targetReadinessDate    String?        @map("target_readiness_date")
  notes                  String?
  nominatedByUserId      String         @map("nominated_by_user_id")
  nominatedAt            DateTime       @default(now()) @map("nominated_at")
  status                 String         @default("ACTIVE") // ACTIVE | REMOVED
  removedAt              DateTime?      @map("removed_at")
  removedByUserId        String?        @map("removed_by_user_id")
  removalReason          String?        @map("removal_reason")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  @@index([planId, status])
  @@index([employeeId, status])
  @@map("succession_candidates")
}

// ---------------------------------------------------------------------------
// Document center and report center (Task 30)
// ---------------------------------------------------------------------------

/// Customer-defined document categories. The scope type names which module's authorization applies on top of the
/// classification; nothing is inferred from a category's name.
model DocumentCategory {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  description           String?
  scopeType             String   @default("GENERAL") @map("scope_type")
  defaultClassification String   @default("EMPLOYEE_PRIVATE") @map("default_classification")
  /// Comma-separated allow-list that narrows the platform list (e.g. ".pdf,.jpg"); null = platform default.
  allowedExtensions     String?  @map("allowed_extensions")
  maxFileSizeBytes      Int?     @map("max_file_size_bytes")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  documents Document[]

  @@map("document_categories")
}

model DocumentSequence {
  year Int @id
  next Int @default(1)

  @@map("document_sequences")
}

/// Metadata about a file. The bytes live in the storage adapter under an opaque key on the current version.
model Document {
  id               String           @id @default(cuid())
  documentNumber   String           @unique @map("document_number")
  title            String
  description      String?
  categoryId       String           @map("category_id")
  category         DocumentCategory @relation(fields: [categoryId], references: [id])
  ownerEmployeeId  String?          @map("owner_employee_id")
  ownerEmployee    Employee?        @relation("DocumentOwner", fields: [ownerEmployeeId], references: [id])
  organizationId   String?          @map("organization_id")
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  classification   String           @default("EMPLOYEE_PRIVATE") // PUBLIC_INTERNAL | EMPLOYEE_PRIVATE | HR_CONFIDENTIAL | RESTRICTED
  status           String           @default("ACTIVE") // ACTIVE | ARCHIVED
  currentVersionId String?          @unique @map("current_version_id")
  currentVersion   DocumentVersion? @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id])
  issuedDate       String?          @map("issued_date")
  expiryDate       String?          @map("expiry_date")
  archivedAt       DateTime?        @map("archived_at")
  createdByUserId  String           @map("created_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  versions DocumentVersion[] @relation("DocumentVersions")
  links    DocumentLink[]

  @@index([ownerEmployeeId, status])
  @@index([categoryId])
  @@index([classification])
  @@index([expiryDate])
  @@map("documents")
}

/// Append-only. A replacement is version N+1 with its own bytes; nothing overwrites a stored object.
model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String   @map("document_id")
  document         Document @relation("DocumentVersions", fields: [documentId], references: [id])
  versionNumber    Int      @map("version_number")
  /// Opaque, server-generated: documents/<2 hex>/<uuid>. Never derived from a name.
  storageKey       String   @unique @map("storage_key")
  originalFilename String   @map("original_filename")
  mimeType         String   @map("mime_type")
  fileSize         Int      @map("file_size")
  sha256           String
  uploadedByUserId String   @map("uploaded_by_user_id")
  uploadedAt       DateTime @default(now()) @map("uploaded_at")
  note             String?

  currentOf Document? @relation("DocumentCurrentVersion")

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

/// Which business record a document is attached to. The entity type is an enum; the id is checked against the real
/// table when the link is made and the linked module's authorization applies to the document from then on.
model DocumentLink {
  id              String   @id @default(cuid())
  documentId      String   @map("document_id")
  document        Document @relation(fields: [documentId], references: [id])
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id")
  relationType    String?  @map("relation_type")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("document_links")
}

/// A report definition: which registry dataset, and a validated JSON of columns / filters / sort / group / aggregate.
/// It names fields from the server-owned registry and never carries a query.
model SavedReport {
  id              String   @id @default(cuid())
  name            String
  description     String?
  datasetId       String   @map("dataset_id")
  ownerUserId     String   @map("owner_user_id")
  visibility      String   @default("PRIVATE") // PRIVATE | SHARED
  definition      Json
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId])
  @@index([visibility, datasetId])
  @@map("saved_reports")
}

// ---------------------------------------------------------------------------------------------------------------
// Task 32 — Organization design and workforce planning. A PLANNED layer beside the live organization: nothing here
// is a second employee, department, job or position master, and nothing here changes one.
// ---------------------------------------------------------------------------------------------------------------

/// A planning cycle ("2027 Workforce Plan"). DRAFT → ACTIVE → FINALIZED → ARCHIVED; finalizing freezes the plan and does nothing else.
model WorkforcePlanningCycle {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  organizationId  String?   @map("organization_id")
  periodStart     String    @map("period_start")
  periodEnd       String    @map("period_end")
  status          String    @default("DRAFT") // DRAFT | ACTIVE | FINALIZED | ARCHIVED
  description     String?
  finalizedAt     DateTime? @map("finalized_at")
  archivedAt      DateTime? @map("archived_at")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  items     WorkforcePlanItem[]
  movements WorkforcePlannedMovement[]
  scenarios OrganizationDesignScenario[]

  @@index([status])
  @@map("workforce_planning_cycles")
}

/// One planning row: department + job. Current headcount is a snapshot taken at initialization and again at finalization.
model WorkforcePlanItem {
  id                       String                 @id @default(cuid())
  cycleId                  String                 @map("cycle_id")
  cycle                    WorkforcePlanningCycle @relation(fields: [cycleId], references: [id])
  organizationId           String                 @map("organization_id")
  departmentId             String                 @map("department_id")
  jobId                    String?                @map("job_id")
  /// department:job (or department:-) — the idempotence key for initialization.
  grainKey                 String                 @map("grain_key")
  departmentNameSnapshot   String                 @map("department_name_snapshot")
  jobTitleSnapshot         String?                @map("job_title_snapshot")
  currentHeadcountSnapshot Int                    @map("current_headcount_snapshot")
  snapshotAt               DateTime               @map("snapshot_at")
  plannedHeadcount         Int                    @map("planned_headcount")
  reason                   String? // GROWTH | REPLACEMENT | RESTRUCTURE | NEW_FUNCTION | SEASONAL | OTHER — chosen by a person
  priority                 String? // LOW | NORMAL | HIGH | CRITICAL — set by a person
  targetDate               String?                @map("target_date")
  notes                    String?
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")

  requisitions WorkforcePlanRequisition[]

  @@unique([cycleId, grainKey])
  @@index([cycleId, departmentId])
  @@map("workforce_plan_items")
}

/// Record of an explicit handoff: HR created this requisition (through the recruitment module) from this plan row.
model WorkforcePlanRequisition {
  id              String            @id @default(cuid())
  planItemId      String            @map("plan_item_id")
  planItem        WorkforcePlanItem @relation(fields: [planItemId], references: [id])
  requisitionId   String            @unique @map("requisition_id")
  createdByUserId String            @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([planItemId])
  @@map("workforce_plan_requisitions")
}

/// A planned movement is a record of intent. The employee master never changes because of it.
model WorkforcePlannedMovement {
  id               String                 @id @default(cuid())
  cycleId          String                 @map("cycle_id")
  cycle            WorkforcePlanningCycle @relation(fields: [cycleId], references: [id])
  employeeId       String?                @map("employee_id")
  fromDepartmentId String?                @map("from_department_id")
  toDepartmentId   String?                @map("to_department_id")
  fromJobId        String?                @map("from_job_id")
  toJobId          String?                @map("to_job_id")
  targetDate       String?                @map("target_date")
  status           String                 @default("PLANNED") // PLANNED | CANCELLED | COMPLETED_EXTERNALLY
  notes            String?
  createdByUserId  String                 @map("created_by_user_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@index([cycleId, status])
  @@map("workforce_planned_movements")
}

/// "What would the organization look like if…" — never the live org chart.
model OrganizationDesignScenario {
  id               String                  @id @default(cuid())
  name             String
  description      String?
  organizationId   String                  @map("organization_id")
  planningCycleId  String?                 @map("planning_cycle_id")
  planningCycle    WorkforcePlanningCycle? @relation(fields: [planningCycleId], references: [id])
  status           String                  @default("DRAFT") // DRAFT | FINALIZED | ARCHIVED
  /// Immutable target snapshot written at finalization (tree + planned headcount + the current figures at that moment).
  finalSnapshot    Json?                   @map("final_snapshot")
  finalizedAt      DateTime?               @map("finalized_at")
  duplicatedFromId String?                 @map("duplicated_from_id")
  createdByUserId  String                  @map("created_by_user_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  nodes     OrganizationDesignNode[]
  positions OrganizationDesignPosition[]

  @@index([organizationId, status])
  @@map("organization_design_scenarios")
}

/// A planned unit. Either a reference to a live department (sourceDepartmentId) or planned-only — no live master row is ever created for it.
model OrganizationDesignNode {
  id                   String                     @id @default(cuid())
  scenarioId           String                     @map("scenario_id")
  scenario             OrganizationDesignScenario @relation(fields: [scenarioId], references: [id])
  nodeType             String                     @map("node_type") // ORGANIZATION | DEPARTMENT | TEAM
  name                 String
  code                 String?
  parentNodeId         String?                    @map("parent_node_id")
  parent               OrganizationDesignNode?    @relation("OrgDesignTree", fields: [parentNodeId], references: [id])
  children             OrganizationDesignNode[]   @relation("OrgDesignTree")
  sourceOrganizationId String?                    @map("source_organization_id")
  sourceDepartmentId   String?                    @map("source_department_id")
  plannedOnly          Boolean                    @default(true) @map("planned_only")
  sortOrder            Int                        @default(0) @map("sort_order")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  positions OrganizationDesignPosition[]

  @@index([scenarioId, parentNodeId])
  @@map("organization_design_nodes")
}

/// Planned headcount for a job (or a not-yet-existing job title) inside a planned unit. No Position row is created.
model OrganizationDesignPosition {
  id               String                     @id @default(cuid())
  scenarioId       String                     @map("scenario_id")
  scenario         OrganizationDesignScenario @relation(fields: [scenarioId], references: [id])
  nodeId           String                     @map("node_id")
  node             OrganizationDesignNode     @relation(fields: [nodeId], references: [id])
  jobId            String?                    @map("job_id")
  plannedJobTitle  String?                    @map("planned_job_title")
  plannedHeadcount Int                        @map("planned_headcount")
  reportsToNodeId  String?                    @map("reports_to_node_id")
  notes            String?
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  @@index([scenarioId, nodeId])
  @@map("organization_design_positions")
}

// ---------------------------------------------------------------------------------------------------------------
// Task 33 — Engagement surveys and eNPS. Participation (who was invited, who completed) is kept apart from answers;
// an anonymous response row carries no employee, user or assignment reference.
// ---------------------------------------------------------------------------------------------------------------

/// Customer-owned question wording. Deactivated, never deleted, once a survey has used it.
model EngagementQuestion {
  id              String   @id @default(cuid())
  code            String   @unique
  theme           String?
  text            String
  questionType    String   @map("question_type") // LIKERT | SCALE | SINGLE_CHOICE | MULTI_CHOICE | YES_NO | TEXT | ENPS
  defaultRequired Boolean  @default(true) @map("default_required")
  /// Validated shape: scaleMin/scaleMax/scaleLabels, options[{code,label}], maxLength.
  config          Json     @default("{}")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  surveyQuestions EngagementSurveyQuestion[]

  @@map("engagement_questions")
}

model EngagementSurvey {
  id                        String    @id @default(cuid())
  code                      String    @unique
  name                      String
  description               String?
  organizationId            String?   @map("organization_id")
  surveyType                String    @map("survey_type") // ENGAGEMENT | ENPS | PULSE | CUSTOM
  /// Chosen in DRAFT, immutable from OPEN on.
  responseMode              String    @map("response_mode") // ANONYMOUS | IDENTIFIED
  minimumAnonymousGroupSize Int       @default(5) @map("minimum_anonymous_group_size")
  periodStart               String?   @map("period_start")
  periodEnd                 String?   @map("period_end")
  status                    String    @default("DRAFT") // DRAFT | OPEN | CLOSED | ARCHIVED
  openedAt                  DateTime? @map("opened_at")
  closedAt                  DateTime? @map("closed_at")
  archivedAt                DateTime? @map("archived_at")
  duplicatedFromId          String?   @map("duplicated_from_id")
  createdByUserId           String    @map("created_by_user_id")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  questions   EngagementSurveyQuestion[]
  assignments EngagementSurveyAssignment[]
  responses   EngagementResponse[]
  cohorts     EngagementSurveyCohort[]

  @@index([status])
  @@map("engagement_surveys")
}

/// A frozen copy of the question as it was asked. Bank edits never change it.
model EngagementSurveyQuestion {
  id                   String              @id @default(cuid())
  surveyId             String              @map("survey_id")
  survey               EngagementSurvey    @relation(fields: [surveyId], references: [id])
  sourceQuestionId     String?             @map("source_question_id")
  sourceQuestion       EngagementQuestion? @relation(fields: [sourceQuestionId], references: [id])
  questionTextSnapshot String              @map("question_text_snapshot")
  themeSnapshot        String?             @map("theme_snapshot")
  questionType         String              @map("question_type")
  required             Boolean             @default(true)
  scaleMin             Int?                @map("scale_min")
  scaleMax             Int?                @map("scale_max")
  isEnpsPrimary        Boolean             @default(false) @map("is_enps_primary")
  displayOrder         Int                 @default(0) @map("display_order")
  /// Validated: scaleLabels, options[{code,label}], maxLength.
  configuration        Json                @default("{}")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  answers EngagementResponseAnswer[]

  @@index([surveyId, displayOrder])
  @@map("engagement_survey_questions")
}

/// A survey-local anonymous cohort: one row per distinct organization / department / job present in the frozen
/// audience, with an opaque random id and the label as it was at opening. Reporting resolves group names through
/// these rows; anonymous answers never point at a master record or a person.
model EngagementSurveyCohort {
  id            String           @id
  surveyId      String           @map("survey_id")
  survey        EngagementSurvey @relation(fields: [surveyId], references: [id])
  dimensionType String           @map("dimension_type") // ORGANIZATION | DEPARTMENT | JOB
  /// The master record this cohort stood for when the survey opened (survey-level metadata, used to map filters).
  sourceId      String           @map("source_id")
  code          String?
  label         String

  @@unique([surveyId, dimensionType, sourceId])
  @@map("engagement_survey_cohorts")
}

/// Participation: who was invited and whether they completed. Dimensions are snapshots taken when the survey opened.
/// For an anonymous survey there is deliberately no path from this row to a response.
model EngagementSurveyAssignment {
  id                     String           @id @default(cuid())
  surveyId               String           @map("survey_id")
  survey                 EngagementSurvey @relation(fields: [surveyId], references: [id])
  employeeId             String           @map("employee_id")
  organizationIdSnapshot String           @map("organization_id_snapshot")
  departmentIdSnapshot   String           @map("department_id_snapshot")
  jobIdSnapshot          String?          @map("job_id_snapshot")
  positionIdSnapshot     String           @map("position_id_snapshot")
  orgCohortId            String?          @map("org_cohort_id")
  deptCohortId           String?          @map("dept_cohort_id")
  jobCohortId            String?          @map("job_cohort_id")
  invitedAt              DateTime         @default(now()) @map("invited_at")
  completedAt            DateTime?        @map("completed_at")

  respondent EngagementIdentifiedRespondent?

  @@unique([surveyId, employeeId])
  @@index([surveyId, departmentIdSnapshot])
  @@index([surveyId, deptCohortId])
  @@map("engagement_survey_assignments")
}

/// One submission. The row holds answers' context only: the survey, the day, and survey-local cohort tokens.
/// It has no employee, user, assignment, organization, department, job or position column at all.
model EngagementResponse {
  id            String           @id @default(cuid())
  surveyId      String           @map("survey_id")
  survey        EngagementSurvey @relation(fields: [surveyId], references: [id])
  responseMode  String           @map("response_mode")
  orgCohortId   String?          @map("org_cohort_id")
  deptCohortId  String?          @map("dept_cohort_id")
  jobCohortId   String?          @map("job_cohort_id")
  submittedDate String           @map("submitted_date")

  answers    EngagementResponseAnswer[]
  respondent EngagementIdentifiedRespondent?

  @@index([surveyId, deptCohortId])
  @@index([surveyId, jobCohortId])
  @@map("engagement_responses")
}

/// IDENTIFIED surveys only: who submitted which response, with the exact time. An anonymous submission never
/// writes this table, so for an anonymous survey there is no row — and no path — from a response to a person.
model EngagementIdentifiedRespondent {
  responseId   String                     @id @map("response_id")
  response     EngagementResponse         @relation(fields: [responseId], references: [id])
  assignmentId String                     @unique @map("assignment_id")
  assignment   EngagementSurveyAssignment @relation(fields: [assignmentId], references: [id])
  employeeId   String                     @map("employee_id")
  submittedAt  DateTime                   @map("submitted_at")

  @@index([employeeId])
  @@map("engagement_identified_respondents")
}

model EngagementResponseAnswer {
  id           String                   @id @default(cuid())
  responseId   String                   @map("response_id")
  response     EngagementResponse       @relation(fields: [responseId], references: [id])
  questionId   String                   @map("question_id")
  question     EngagementSurveyQuestion @relation(fields: [questionId], references: [id])
  numericValue Int?                     @map("numeric_value")
  booleanValue Boolean?                 @map("boolean_value")
  textValue    String?                  @map("text_value")
  choiceValues Json?                    @map("choice_values")

  @@unique([responseId, questionId])
  @@index([questionId, numericValue])
  @@map("engagement_response_answers")
}

// ---------------------------------------------------------------------------------------------------------------
// Task 34 — Employee lifecycle: onboarding, probation, offboarding. Checklists and decisions beside the employee
// master. The master changes only through the explicit separation completion, via the employees domain helper.
// ---------------------------------------------------------------------------------------------------------------

model LifecycleTemplate {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  type           String // ONBOARDING | OFFBOARDING
  organizationId String?  @map("organization_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tasks LifecycleTemplateTask[]

  @@index([type, isActive])
  @@map("lifecycle_templates")
}

model LifecycleTemplateTask {
  id                 String            @id @default(cuid())
  templateId         String            @map("template_id")
  template           LifecycleTemplate @relation(fields: [templateId], references: [id])
  title              String
  description        String?
  category           String
  assigneeType       String            @map("assignee_type") // EMPLOYEE | MANAGER | HR | SPECIFIC_USER
  specificUserId     String?           @map("specific_user_id")
  dueOffsetDays      Int               @map("due_offset_days")
  relativeTo         String            @map("relative_to") // HIRE_DATE | START_DATE | LAST_WORKING_DATE | CASE_START
  required           Boolean           @default(true)
  sortOrder          Int               @default(0) @map("sort_order")
  documentCategoryId String?           @map("document_category_id")
  requiresDocument   Boolean           @default(false) @map("requires_document")

  @@index([templateId, sortOrder])
  @@map("lifecycle_template_tasks")
}

/// A checklist for one new joiner. Snapshots the employee's context at creation; tasks are copies of the template.
model OnboardingPlan {
  id                   String    @id @default(cuid())
  employeeId           String    @map("employee_id")
  templateId           String?   @map("template_id")
  templateNameSnapshot String?   @map("template_name_snapshot")
  employeeCodeSnapshot String    @map("employee_code_snapshot")
  employeeNameSnapshot String    @map("employee_name_snapshot")
  organizationSnapshot String?   @map("organization_snapshot")
  departmentSnapshot   String?   @map("department_snapshot")
  jobSnapshot          String?   @map("job_snapshot")
  positionSnapshot     String?   @map("position_snapshot")
  managerIdSnapshot    String?   @map("manager_id_snapshot")
  managerNameSnapshot  String?   @map("manager_name_snapshot")
  managerCodeSnapshot  String?   @map("manager_code_snapshot")
  departmentIdSnapshot String?   @map("department_id_snapshot")
  hireDateSnapshot     String    @map("hire_date_snapshot")
  startDate            String    @map("start_date")
  status               String    @default("DRAFT") // DRAFT | ACTIVE | COMPLETED | CANCELLED
  hrOwnerUserId        String?   @map("hr_owner_user_id")
  applicationId        String?   @map("application_id")
  probationCaseId      String?   @map("probation_case_id")
  createdByUserId      String    @map("created_by_user_id")
  activatedAt          DateTime? @map("activated_at")
  completedAt          DateTime? @map("completed_at")
  cancelledAt          DateTime? @map("cancelled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tasks OnboardingTask[]

  @@index([employeeId, status])
  @@index([status])
  @@map("onboarding_plans")
}

model OnboardingTask {
  id                  String         @id @default(cuid())
  planId              String         @map("plan_id")
  plan                OnboardingPlan @relation(fields: [planId], references: [id])
  titleSnapshot       String         @map("title_snapshot")
  descriptionSnapshot String?        @map("description_snapshot")
  categorySnapshot    String         @map("category_snapshot")
  assigneeType        String         @map("assignee_type")
  assigneeUserId      String?        @map("assignee_user_id")
  assigneeEmployeeId  String?        @map("assignee_employee_id")
  dueDate             String         @map("due_date")
  required            Boolean        @default(true)
  requiresDocument    Boolean        @default(false) @map("requires_document")
  documentId          String?        @map("document_id")
  status              String         @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED | CANCELLED
  completedAt         DateTime?      @map("completed_at")
  completedByUserId   String?        @map("completed_by_user_id")
  /// Operational note. Never a password or a secret; audited by length only.
  note                String?
  sortOrder           Int            @default(0) @map("sort_order")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([planId, status])
  @@index([assigneeUserId, status])
  @@map("onboarding_tasks")
}

/// Customer-configurable probation terms. No duration is hardcoded anywhere.
model ProbationPolicy {
  id               String   @id @default(cuid())
  name             String
  organizationId   String?  @map("organization_id")
  durationDays     Int      @map("duration_days")
  reviewLeadDays   Int?     @map("review_lead_days")
  allowExtension   Boolean  @default(true) @map("allow_extension")
  maxExtensionDays Int?     @map("max_extension_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  cases ProbationCase[]

  @@map("probation_policies")
}

model ProbationCase {
  id                   String           @id @default(cuid())
  employeeId           String           @map("employee_id")
  policyId             String?          @map("policy_id")
  policy               ProbationPolicy? @relation(fields: [policyId], references: [id])
  policyNameSnapshot   String?          @map("policy_name_snapshot")
  allowExtension       Boolean          @default(true) @map("allow_extension")
  maxExtensionDays     Int?             @map("max_extension_days")
  employeeCodeSnapshot String           @map("employee_code_snapshot")
  employeeNameSnapshot String           @map("employee_name_snapshot")
  organizationSnapshot String?          @map("organization_snapshot")
  departmentSnapshot   String?          @map("department_snapshot")
  departmentIdSnapshot String?          @map("department_id_snapshot")
  jobSnapshot          String?          @map("job_snapshot")
  positionSnapshot     String?          @map("position_snapshot")
  managerIdSnapshot    String?          @map("manager_id_snapshot")
  managerNameSnapshot  String?          @map("manager_name_snapshot")
  managerCodeSnapshot  String?          @map("manager_code_snapshot")
  startDate            String           @map("start_date")
  originalEndDate      String           @map("original_end_date")
  currentEndDate       String           @map("current_end_date")
  reviewerUserId       String?          @map("reviewer_user_id")
  status               String           @default("ACTIVE") // ACTIVE | PENDING_REVIEW | PASSED | EXTENDED | NOT_PASSED | CANCELLED
  finalOutcome         String?          @map("final_outcome")
  finalizedAt          DateTime?        @map("finalized_at")
  cancelledAt          DateTime?        @map("cancelled_at")
  createdByUserId      String           @map("created_by_user_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  reviews ProbationReview[]

  @@index([employeeId, status])
  @@index([status, currentEndDate])
  @@index([reviewerUserId, status])
  @@map("probation_cases")
}

/// One review event. Never overwritten; an extension keeps the previous event.
model ProbationReview {
  id               String        @id @default(cuid())
  caseId           String        @map("case_id")
  case             ProbationCase @relation(fields: [caseId], references: [id])
  reviewerUserId   String        @map("reviewer_user_id")
  reviewDate       String        @map("review_date")
  outcome          String // PASS | EXTEND | NOT_PASS
  /// Reviewer's words. HR and the reviewer only; never the employee, never the executive, never audited.
  comment          String?
  extensionEndDate String?       @map("extension_end_date")
  previousEndDate  String        @map("previous_end_date")
  submittedAt      DateTime      @default(now()) @map("submitted_at")

  @@index([caseId, submittedAt])
  @@map("probation_reviews")
}

model OffboardingCase {
  id                        String    @id @default(cuid())
  employeeId                String    @map("employee_id")
  templateId                String?   @map("template_id")
  templateNameSnapshot      String?   @map("template_name_snapshot")
  reasonCode                String    @map("reason_code")
  /// HR-confidential. Never to the employee, the manager or the executive; audited by length only.
  reasonNote                String?   @map("reason_note")
  plannedLastWorkingDate    String    @map("planned_last_working_date")
  actualLastWorkingDate     String?   @map("actual_last_working_date")
  employeeCodeSnapshot      String    @map("employee_code_snapshot")
  employeeNameSnapshot      String    @map("employee_name_snapshot")
  organizationSnapshot      String?   @map("organization_snapshot")
  departmentSnapshot        String?   @map("department_snapshot")
  departmentIdSnapshot      String?   @map("department_id_snapshot")
  jobSnapshot               String?   @map("job_snapshot")
  positionSnapshot          String?   @map("position_snapshot")
  managerIdSnapshot         String?   @map("manager_id_snapshot")
  managerNameSnapshot       String?   @map("manager_name_snapshot")
  managerCodeSnapshot       String?   @map("manager_code_snapshot")
  status                    String    @default("DRAFT") // DRAFT | ACTIVE | READY_TO_COMPLETE | COMPLETED | CANCELLED
  hrOwnerUserId             String?   @map("hr_owner_user_id")
  exitInterviewDate         String?   @map("exit_interview_date")
  exitReasonCategory        String?   @map("exit_reason_category")
  exitWouldRejoin           Boolean?  @map("exit_would_rejoin")
  /// HR-confidential exit interview note. No sentiment analysis, no cross-domain effect.
  exitInterviewNote         String?   @map("exit_interview_note")
  exitInterviewerUserId     String?   @map("exit_interviewer_user_id")
  separationAccountDisabled Boolean?  @map("separation_account_disabled")
  separationSessionsRevoked Int?      @map("separation_sessions_revoked")
  createdByUserId           String    @map("created_by_user_id")
  activatedAt               DateTime? @map("activated_at")
  completedAt               DateTime? @map("completed_at")
  cancelledAt               DateTime? @map("cancelled_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  tasks OffboardingTask[]

  @@index([employeeId, status])
  @@index([status, plannedLastWorkingDate])
  @@map("offboarding_cases")
}

model OffboardingTask {
  id                  String          @id @default(cuid())
  caseId              String          @map("case_id")
  case                OffboardingCase @relation(fields: [caseId], references: [id])
  titleSnapshot       String          @map("title_snapshot")
  descriptionSnapshot String?         @map("description_snapshot")
  categorySnapshot    String          @map("category_snapshot")
  assigneeType        String          @map("assignee_type")
  assigneeUserId      String?         @map("assignee_user_id")
  assigneeEmployeeId  String?         @map("assignee_employee_id")
  dueDate             String          @map("due_date")
  required            Boolean         @default(true)
  requiresDocument    Boolean         @default(false) @map("requires_document")
  documentId          String?         @map("document_id")
  status              String          @default("PENDING")
  completedAt         DateTime?       @map("completed_at")
  completedByUserId   String?         @map("completed_by_user_id")
  note                String?
  sortOrder           Int             @default(0) @map("sort_order")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  @@index([caseId, status])
  @@index([assigneeUserId, status])
  @@map("offboarding_tasks")
}

// ---------------------------------------------------------------------------------------------------------------
// Task 35 — OJT, learning paths and certifications. Learning records beside Task 25 training and Task 24
// competency: nothing here changes a competency level, a performance score or an employment status.
// ---------------------------------------------------------------------------------------------------------------

model LearningSequence {
  kind String
  year Int
  next Int    @default(1)

  @@id([kind, year])
  @@map("learning_sequences")
}

model OjtProgram {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?
  organizationId  String?  @map("organization_id")
  jobId           String?  @map("job_id")
  durationDays    Int?     @map("duration_days")
  isActive        Boolean  @default(true) @map("is_active")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  competencies OjtProgramCompetency[]
  activities   OjtProgramActivity[]
  plans        OjtPlan[]

  @@map("ojt_programs")
}

/// A learning objective: the level the program aims at is expected evidence, never a level granted.
model OjtProgramCompetency {
  id           String     @id @default(cuid())
  programId    String     @map("program_id")
  program      OjtProgram @relation(fields: [programId], references: [id])
  competencyId String     @map("competency_id")
  targetLevel  Int?       @map("target_level")
  importance   String? // CORE | SUPPORTING
  description  String?

  @@unique([programId, competencyId])
  @@map("ojt_program_competencies")
}

model OjtProgramActivity {
  id                       String     @id @default(cuid())
  programId                String     @map("program_id")
  program                  OjtProgram @relation(fields: [programId], references: [id])
  title                    String
  description              String?
  activityType             String     @map("activity_type") // OBSERVE | PRACTICE | PERFORM | REVIEW | OTHER
  sequence                 Int
  required                 Boolean    @default(true)
  expectedDays             Int?       @map("expected_days")
  documentEvidenceRequired Boolean    @default(false) @map("document_evidence_required")

  criteria OjtActivityCriterion[]

  @@index([programId, sequence])
  @@map("ojt_program_activities")
}

model OjtActivityCriterion {
  id         String             @id @default(cuid())
  activityId String             @map("activity_id")
  activity   OjtProgramActivity @relation(fields: [activityId], references: [id])
  criterion  String
  sequence   Int
  required   Boolean            @default(true)

  @@index([activityId, sequence])
  @@map("ojt_activity_criteria")
}

/// One trainee's plan: a snapshot of the program at creation with its own activity and criterion copies.
model OjtPlan {
  id                   String      @id @default(cuid())
  planNumber           String      @unique @map("plan_number")
  employeeId           String      @map("employee_id")
  programId            String?     @map("program_id")
  program              OjtProgram? @relation(fields: [programId], references: [id])
  programNameSnapshot  String      @map("program_name_snapshot")
  employeeCodeSnapshot String      @map("employee_code_snapshot")
  employeeNameSnapshot String      @map("employee_name_snapshot")
  organizationSnapshot String?     @map("organization_snapshot")
  departmentSnapshot   String?     @map("department_snapshot")
  departmentIdSnapshot String?     @map("department_id_snapshot")
  jobSnapshot          String?     @map("job_snapshot")
  positionSnapshot     String?     @map("position_snapshot")
  trainerEmployeeId    String?     @map("trainer_employee_id")
  trainerUserId        String?     @map("trainer_user_id")
  trainerNameSnapshot  String?     @map("trainer_name_snapshot")
  startDate            String      @map("start_date")
  targetEndDate        String?     @map("target_end_date")
  status               String      @default("DRAFT") // DRAFT | ACTIVE | COMPLETED | CANCELLED
  trainingNeedId       String?     @map("training_need_id")
  idpItemId            String?     @map("idp_item_id")
  createdByUserId      String      @map("created_by_user_id")
  activatedAt          DateTime?   @map("activated_at")
  completedAt          DateTime?   @map("completed_at")
  cancelledAt          DateTime?   @map("cancelled_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  competencies OjtPlanCompetency[]
  activities   OjtPlanActivity[]
  assessments  OjtPlanAssessment[]

  @@index([employeeId, status])
  @@index([trainerUserId, status])
  @@index([status])
  @@map("ojt_plans")
}

model OjtPlanCompetency {
  id                     String  @id @default(cuid())
  planId                 String  @map("plan_id")
  plan                   OjtPlan @relation(fields: [planId], references: [id])
  competencyId           String  @map("competency_id")
  competencyCodeSnapshot String  @map("competency_code_snapshot")
  competencyNameSnapshot String  @map("competency_name_snapshot")
  targetLevel            Int?    @map("target_level")
  importance             String?
  description            String?

  @@index([planId])
  @@map("ojt_plan_competencies")
}

model OjtPlanActivity {
  id                  String    @id @default(cuid())
  planId              String    @map("plan_id")
  plan                OjtPlan   @relation(fields: [planId], references: [id])
  titleSnapshot       String    @map("title_snapshot")
  descriptionSnapshot String?   @map("description_snapshot")
  activityType        String    @map("activity_type")
  sequence            Int
  required            Boolean   @default(true)
  expectedDays        Int?      @map("expected_days")
  requiresEvidence    Boolean   @default(false) @map("requires_evidence")
  documentId          String?   @map("document_id")
  status              String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED
  startedAt           DateTime? @map("started_at")
  completedAt         DateTime? @map("completed_at")
  /// Trainer's words: trainer and HR only. Employee's words: the employee, the trainer and HR. Neither is audited.
  trainerComment      String?   @map("trainer_comment")
  employeeReflection  String?   @map("employee_reflection")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  criteria     OjtPlanCriterion[]
  observations OjtActivityObservation[]

  @@index([planId, sequence])
  @@map("ojt_plan_activities")
}

model OjtPlanCriterion {
  id                String          @id @default(cuid())
  planActivityId    String          @map("plan_activity_id")
  planActivity      OjtPlanActivity @relation(fields: [planActivityId], references: [id])
  criterionSnapshot String          @map("criterion_snapshot")
  sequence          Int
  required          Boolean         @default(true)

  observations OjtActivityObservation[]

  @@index([planActivityId, sequence])
  @@map("ojt_plan_criteria")
}

/// Evidence, not a score: one final observation per criterion per observer, replaced on resubmission.
model OjtActivityObservation {
  id             String           @id @default(cuid())
  planActivityId String           @map("plan_activity_id")
  planActivity   OjtPlanActivity  @relation(fields: [planActivityId], references: [id])
  criterionId    String           @map("criterion_id")
  criterion      OjtPlanCriterion @relation(fields: [criterionId], references: [id])
  observerUserId String           @map("observer_user_id")
  result         String // NOT_OBSERVED | MEETS | NEEDS_PRACTICE
  comment        String?
  observedAt     String           @map("observed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([criterionId, observerUserId])
  @@index([planActivityId])
  @@map("ojt_activity_observations")
}

/// A human's final word on the plan. No number.
model OjtPlanAssessment {
  id             String   @id @default(cuid())
  planId         String   @map("plan_id")
  plan           OjtPlan  @relation(fields: [planId], references: [id])
  assessorUserId String   @map("assessor_user_id")
  outcome        String // COMPLETED | MORE_PRACTICE_REQUIRED
  comment        String?
  submittedAt    DateTime @default(now()) @map("submitted_at")

  @@index([planId, submittedAt])
  @@map("ojt_plan_assessments")
}

/// The handoff to competency assessment: a pointer an assessor can read, never a level written anywhere.
model CompetencyEvidence {
  id              String   @id @default(cuid())
  employeeId      String   @map("employee_id")
  competencyId    String   @map("competency_id")
  sourceType      String   @map("source_type") // OJT
  sourceId        String   @map("source_id")
  sourceLabel     String   @map("source_label")
  /// The level the source aimed at (an OJT program objective). It is what the evidence was gathered *towards*, never a level anybody observed.
  objectiveLevelSnapshot Int? @map("objective_level_snapshot")
  /// Set only by an explicit human level observation on the competency's scale. No such action exists in this release, so it stays null.
  observedLevel   Int?     @map("observed_level")
  note            String?
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([sourceType, sourceId, competencyId])
  @@index([employeeId, competencyId])
  @@map("competency_evidence")
}

model LearningPath {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  organizationId String?  @map("organization_id")
  targetJobId    String?  @map("target_job_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  steps       LearningPathStep[]
  assignments LearningPathAssignment[]

  @@map("learning_paths")
}

model LearningPathStep {
  id                 String       @id @default(cuid())
  pathId             String       @map("path_id")
  path               LearningPath @relation(fields: [pathId], references: [id])
  stepType           String       @map("step_type") // COURSE | OJT_PROGRAM | IDP_ACTIVITY | CERTIFICATION
  referenceId        String?      @map("reference_id")
  titleSnapshot      String       @map("title_snapshot")
  sequence           Int
  required           Boolean      @default(true)
  prerequisiteStepId String?      @map("prerequisite_step_id")

  @@index([pathId, sequence])
  @@map("learning_path_steps")
}

model LearningPathAssignment {
  id                     String       @id @default(cuid())
  pathId                 String       @map("path_id")
  path                   LearningPath @relation(fields: [pathId], references: [id])
  pathNameSnapshot       String       @map("path_name_snapshot")
  targetJobTitleSnapshot String?      @map("target_job_title_snapshot")
  employeeId             String       @map("employee_id")
  employeeCodeSnapshot   String       @map("employee_code_snapshot")
  employeeNameSnapshot   String       @map("employee_name_snapshot")
  organizationSnapshot   String?      @map("organization_snapshot")
  departmentSnapshot     String?      @map("department_snapshot")
  departmentIdSnapshot   String?      @map("department_id_snapshot")
  jobSnapshot            String?      @map("job_snapshot")
  positionSnapshot       String?      @map("position_snapshot")
  assignedByUserId       String       @map("assigned_by_user_id")
  assignedAt             DateTime     @default(now()) @map("assigned_at")
  targetDate             String?      @map("target_date")
  status                 String       @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  completedAt            DateTime?    @map("completed_at")
  cancelledAt            DateTime?    @map("cancelled_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  steps LearningPathAssignmentStep[]

  @@index([employeeId, status])
  @@index([pathId, status])
  @@map("learning_path_assignments")
}

/// The steps as they were when assigned. Fulfilment is a projection of the source domain, cached when observed.
model LearningPathAssignmentStep {
  id                   String                 @id @default(cuid())
  assignmentId         String                 @map("assignment_id")
  assignment           LearningPathAssignment @relation(fields: [assignmentId], references: [id])
  stepType             String                 @map("step_type")
  referenceId          String?                @map("reference_id")
  titleSnapshot        String                 @map("title_snapshot")
  sequence             Int
  required             Boolean                @default(true)
  prerequisiteSequence Int?                   @map("prerequisite_sequence")
  fulfilledAt          DateTime?              @map("fulfilled_at")
  fulfilledSourceId    String?                @map("fulfilled_source_id")
  fulfilledByUserId    String?                @map("fulfilled_by_user_id")
  note                 String?

  @@index([assignmentId, sequence])
  @@map("learning_path_assignment_steps")
}

model CertificationDefinition {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  description      String?
  issuerType       String   @map("issuer_type") // INTERNAL | EXTERNAL
  issuerName       String?  @map("issuer_name")
  organizationId   String?  @map("organization_id")
  validityDays     Int?     @map("validity_days")
  expiryWindowDays Int?     @map("expiry_window_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  certifications EmployeeCertification[]

  @@map("certification_definitions")
}

/// One issuance. A renewal is a new row pointing at the old one; the old one is never overwritten.
model EmployeeCertification {
  id                     String                  @id @default(cuid())
  employeeId             String                  @map("employee_id")
  definitionId           String                  @map("definition_id")
  definition             CertificationDefinition @relation(fields: [definitionId], references: [id])
  definitionNameSnapshot String                  @map("definition_name_snapshot")
  certificateNumber      String?                 @map("certificate_number")
  issuedDate             String                  @map("issued_date")
  expiryDate             String?                 @map("expiry_date")
  issuerName             String?                 @map("issuer_name")
  documentId             String?                 @map("document_id")
  renewedFromId          String?                 @unique @map("renewed_from_id")
  revokedAt              DateTime?               @map("revoked_at")
  revokedByUserId        String?                 @map("revoked_by_user_id")
  revokeReason           String?                 @map("revoke_reason")
  note                   String?
  createdByUserId        String                  @map("created_by_user_id")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@unique([employeeId, definitionId, issuedDate])
  @@index([employeeId])
  @@index([definitionId, expiryDate])
  @@map("employee_certifications")
}
