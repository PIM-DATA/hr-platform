# ---- API ----
# development | test | production. Production validates this file strictly and refuses to start on dev leftovers.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Optional: point at a config file outside the repo (production installs), e.g. ENV_FILE=/etc/hr-platform/api.env
# ENV_FILE=

# ---- Production settings (see docs/production-readiness.md) ----
# Number of reverse-proxy hops in front of the API. 0 = direct exposure, 1 = one proxy (the usual platform setup).
# It drives req.ip (rate limiting) and req.protocol (secure cookies), so it must match the real topology.
TRUST_PROXY=0
# Per-IP request ceiling per minute (0 disables). The login limiter below is much stricter; health checks are exempt.
API_RATE_LIMIT_PER_MINUTE=600
# Maximum JSON body size. There are no uploads yet, so requests stay small.
JSON_BODY_LIMIT=1mb
# Build marker reported by /api/v1/health and the startup log. Use the release version, e.g. 0.1.0-rc.1.
# APP_VERSION=0.1.0-rc.1

# PostgreSQL is the canonical database (Task 10.5+). Two SEPARATE databases are required:
#   DATABASE_URL      → development database (seeded demo data)
#   TEST_DATABASE_URL → dedicated test database; `npm test` DROPS and recreates its schema on every run.
# NODE_ENV=test refuses to start without TEST_DATABASE_URL and refuses TEST_DATABASE_URL == DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hr_enterprise_dev?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hr_enterprise_test?schema=public"

# Browser origin(s) allowed to call the API, comma-separated. Development uses the Vite proxy, so this only matters
# for split deployments. PRODUCTION: https origins only, never localhost, never "*" (session cookies are credentialed).
CORS_ORIGIN=http://localhost:5173

# Public URL of the web app. Password reset links are built from it — never from the request Host header.
# REQUIRED in production: https, no credentials, no query string or fragment, not localhost.
# Development may leave it unset and falls back to the first CORS_ORIGIN.
# PUBLIC_APP_URL=https://hr.example.com
# Lifetime of an admin-issued password reset link, in minutes (5-1440).
PASSWORD_RESET_TTL_MINUTES=60

# ---- HR Copilot (Task 31) — optional, OFF by default. The core application never depends on it. ----
# When enabled, questions and the minimized tool results the copilot retrieves are sent to the configured provider.
# Review the provider's terms and your data-protection obligations before enabling it (docs/hr-copilot.md).
COPILOT_ENABLED=false
# anthropic | fake. "fake" is a deterministic offline provider for development and tests; production refuses it.
COPILOT_PROVIDER=anthropic
COPILOT_MODEL=claude-sonnet-5
# Provider credential. Required in production when COPILOT_ENABLED=true. Never commit a real value.
# COPILOT_API_KEY=
COPILOT_TIMEOUT_MS=30000
COPILOT_MAX_TOOL_STEPS=6
COPILOT_MAX_INPUT_CHARS=12000
COPILOT_MAX_OUTPUT_TOKENS=1024
# Copilot messages per user per minute (stricter than the API limiter).
COPILOT_RATE_LIMIT=20

# Session
SESSION_TTL_HOURS=12
# Login rate limit (failed attempts per IP within the window). In-memory; use a shared store for multi-instance production.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
COOKIE_SECURE=false   # set true in production (HTTPS)

# ---- Seed (LOCAL DEVELOPMENT ONLY; `npm run db:seed:demo` refuses to run with NODE_ENV=production) ----
# Production creates its first administrator explicitly:
#   BOOTSTRAP_ADMIN_EMAIL=... BOOTSTRAP_ADMIN_PASSWORD=... npm run bootstrap:admin
# NOTE: these seed credentials are the ONE exception to the shared 12-character password policy; they only ever run
# outside production. Anything a person sets inside the application needs at least 12 characters.
SEED_ADMIN_EMAIL=admin@company.local
SEED_ADMIN_PASSWORD=change-me-locally
# Optional: creates demo accounts (hradmin@ / hr@ / manager@ / employee@ / executive@company.local) with this password
SEED_DEMO_PASSWORD=
