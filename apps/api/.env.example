# ---- API ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# SQLite for local development only. For PostgreSQL:
#   DATABASE_URL="postgresql://user:password@localhost:5432/hr_platform?schema=public"
#   and change `provider = "sqlite"` -> `provider = "postgresql"` in apps/api/prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Frontend origin allowed for CORS (dev uses Vite proxy so this is only for split deployments)
CORS_ORIGIN=http://localhost:5173

# Session
SESSION_TTL_HOURS=12
COOKIE_SECURE=false   # set true in production (HTTPS)

# ---- Seed (local development only; never commit real values) ----
SEED_ADMIN_EMAIL=admin@company.local
SEED_ADMIN_PASSWORD=change-me-locally
