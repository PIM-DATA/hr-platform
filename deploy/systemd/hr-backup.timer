# EXAMPLE schedule: daily at 01:30 local time. The interval is the operator's decision — it bounds, but does not
# guarantee, how much data a restore can lose (see docs/backup-restore.md "RPO").
[Unit]
Description=HR Enterprise Platform backup schedule

[Timer]
OnCalendar=*-*-* 01:30:00
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
