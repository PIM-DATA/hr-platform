# dependencies
node_modules/

# env / secrets
.env
.env.*
!.env.example

# database files (SQLite - local only)
*.db
*.db-journal
*.sqlite
*.sqlite3

# logs
logs/
*.log
npm-debug.log*

# build output
dist/
build/
apps/web/dist/

# prisma generated client lives in node_modules (ignored above)

# editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# test
coverage/

# operational backups (never committed — they contain every HR record)
apps/api/backups/
*.dump
*.dump.partial
*.manifest.json

# stray compiled output next to shared sources (build emits to packages/shared/dist only)
packages/shared/src/**/*.js
packages/shared/src/**/*.d.ts

# document center local storage (dev/pilot)
.data/
